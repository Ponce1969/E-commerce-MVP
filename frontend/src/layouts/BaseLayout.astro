---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentNav?: 'home' | 'catalogo' | 'portal' | 'admin';
}

const {
  title = '2 Rodríguez Distribuidora | Catálogo Mayorista y B2B',
  description = 'Distribuidora de productos de limpieza, higiene y químicos profesionales en Montevideo. Retiro en Paso Molino y envíos a todo el país.',
  currentNav = 'home',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="relative flex min-h-full flex-col bg-background text-foreground antialiased selection:bg-primary/20 selection:text-primary">
    <!-- Ambient Atmospheric Background (Unified across Home, Catálogo, Portal, etc.) -->
    <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
      <!-- Glow superior derecho (Azul institucional) -->
      <div class="absolute -top-32 right-0 h-[600px] w-[600px] rounded-full bg-blue-500/8 blur-[130px]"></div>
      <!-- Glow central izquierdo (Verde lima de limpieza y frescura) -->
      <div class="absolute top-[35%] -left-32 h-[550px] w-[550px] rounded-full bg-emerald-500/8 blur-[130px]"></div>
      <!-- Glow inferior derecho (Azul tenue) -->
      <div class="absolute -bottom-32 right-1/4 h-[500px] w-[500px] rounded-full bg-blue-600/6 blur-[130px]"></div>
      <!-- Micro-textura de cuadrícula / higiene profesional -->
      <div class="absolute inset-0 bg-[radial-gradient(#0b4ca0_1px,transparent_1px)] [background-size:28px_28px] opacity-[0.025]"></div>
    </div>

    <!-- Header / Navbar -->
    <header class="relative z-40 sticky top-0 w-full border-b border-border/80 bg-background/85 backdrop-blur-md">
      <div class="container mx-auto flex h-16 max-w-7xl items-center justify-between px-3 sm:px-6 lg:px-8">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 sm:gap-2.5 transition-opacity hover:opacity-90 shrink min-w-0">
          <img
            src="/logo.png"
            alt="2 Rodríguez Distribuidora"
            class="h-9 sm:h-10 w-auto max-w-[100px] sm:max-w-[120px] object-contain rounded shrink-0"
            onerror="this.style.display='none'; const fb = document.getElementById('logoFallback'); if(fb) fb.style.display='flex';"
          />
          <div id="logoFallback" class="hidden h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-lg bg-primary text-primary-foreground font-black text-lg sm:text-xl shadow-sm shrink-0">
            2R
          </div>
          <div class="flex flex-col min-w-0">
            <span class="font-bold tracking-tight text-sm sm:text-lg leading-tight truncate">2 Rodríguez</span>
            <span class="text-[10px] sm:text-xs text-muted-foreground uppercase font-medium tracking-wider truncate">Distribuidora</span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-5 text-sm font-medium">
          <a
            href="/"
            class:list={[
              'transition-colors hover:text-primary',
              currentNav === 'home' ? 'text-primary font-semibold' : 'text-muted-foreground',
            ]}
          >
            Inicio
          </a>
          <a
            href="/catalogo"
            class:list={[
              'transition-colors hover:text-primary',
              currentNav === 'catalogo' ? 'text-primary font-semibold' : 'text-muted-foreground',
            ]}
          >
            Catálogo
          </a>
          <a
            href="/#retiro"
            class="text-muted-foreground transition-colors hover:text-primary"
          >
            Paso Molino
          </a>
          <a
            href="/portal"
            class:list={[
              'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs sm:text-sm font-semibold transition-all',
              currentNav === 'portal'
                ? 'bg-primary text-primary-foreground border-primary shadow-xs'
                : 'border-border text-foreground hover:bg-accent hover:border-primary/50',
            ]}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <span>Acceso Clientes</span>
          </a>
        </nav>

        <!-- Actions / WhatsApp CTA + Mobile Hamburger -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <a
            href="https://wa.me/59895250673?text=Hola%202%20Rodriguez%2C%20quisiera%20consultar%20por%20precios%20mayoristas"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp 095 250 673"
            class="inline-flex items-center justify-center rounded-lg bg-emerald-600 px-2.5 sm:px-3.5 py-2 text-xs sm:text-sm font-semibold text-white shadow-sm hover:bg-emerald-700 transition-colors gap-1.5 sm:gap-2 min-h-[42px]"
          >
            <span class="h-2 w-2 rounded-full bg-emerald-200 animate-pulse"></span>
            <svg class="h-4 w-4 fill-current sm:hidden" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span class="hidden sm:inline">WhatsApp</span>
            <span class="hidden min-[380px]:inline">095 250 673</span>
          </a>

          <!-- Mobile Hamburger Toggle Button -->
          <button
            id="mobileMenuToggle"
            type="button"
            class="md:hidden inline-flex items-center justify-center p-2 rounded-lg border border-border bg-card text-foreground hover:bg-accent hover:text-accent-foreground focus:outline-none focus:ring-2 focus:ring-primary min-h-[42px] min-w-[42px] transition-colors cursor-pointer"
            aria-label="Abrir menú de navegación"
            aria-expanded="false"
            aria-controls="mobileMenu"
          >
            <svg id="hamburgerIcon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="closeIcon" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Menu Dropdown/Drawer -->
      <div
        id="mobileMenu"
        class="hidden md:hidden border-t border-border bg-background/98 backdrop-blur-xl shadow-xl transition-all duration-200"
      >
        <div class="container mx-auto px-4 py-4 space-y-3">
          <nav class="flex flex-col space-y-1 text-base font-medium">
            <a
              href="/"
              class:list={[
                'flex items-center gap-3 px-3.5 py-3 rounded-lg transition-colors min-h-[44px]',
                currentNav === 'home'
                  ? 'bg-primary/10 text-primary font-bold'
                  : 'text-foreground hover:bg-accent hover:text-accent-foreground',
              ]}
            >
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
              </svg>
              <span>Inicio</span>
            </a>

            <a
              href="/catalogo"
              class:list={[
                'flex items-center justify-between px-3.5 py-3 rounded-lg transition-colors min-h-[44px]',
                currentNav === 'catalogo'
                  ? 'bg-primary/10 text-primary font-bold'
                  : 'text-foreground hover:bg-accent hover:text-accent-foreground',
              ]}
            >
              <div class="flex items-center gap-3">
                <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
                </svg>
                <span>Catálogo Completo</span>
              </div>
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-primary/10 text-primary">311 arts.</span>
            </a>

            <a
              href="/#retiro"
              class="flex items-center gap-3 px-3.5 py-3 rounded-lg text-foreground hover:bg-accent hover:text-accent-foreground transition-colors min-h-[44px]"
            >
              <svg class="h-5 w-5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>Punto de Retiro (Paso Molino)</span>
            </a>

            <a
              href="/portal"
              class:list={[
                'flex items-center justify-between px-3.5 py-3 rounded-lg border font-semibold transition-all min-h-[44px] mt-1',
                currentNav === 'portal'
                  ? 'bg-primary text-primary-foreground border-primary shadow-xs'
                  : 'border-primary/30 bg-primary/5 text-primary hover:bg-primary/10',
              ]}
            >
              <div class="flex items-center gap-3">
                <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                  <circle cx="12" cy="7" r="4" />
                </svg>
                <span>Acceso Clientes Mayoristas</span>
              </div>
              <span>&rarr;</span>
            </a>
          </nav>

          <!-- Quick Info / Retiro in Mobile Menu -->
          <div class="pt-3 border-t border-border space-y-2 text-xs text-muted-foreground">
            <div class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold shrink-0">📍</span>
              <span>Ángel Salvo 56 (Ferretería junto a la vía) — Retiro sin costo</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold shrink-0">🕒</span>
              <span>Lun a Vie: 08-12 y 14-18 hs | Sáb: 08-13 hs</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="relative z-10 flex-1 w-full max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 md:py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="relative z-10 border-t border-border bg-card/90 backdrop-blur-xs text-card-foreground mt-auto">
      <div class="container mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="font-bold text-lg text-primary">2 Rodríguez Distribuidora</span>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Abastecimiento integral para empresas, residenciales, lavanderías y particulares. Artículos de limpieza, desinfección y químicos con stock garantizado.
            </p>
          </div>
          <div>
            <h4 class="font-semibold text-sm mb-3 text-foreground uppercase tracking-wider">Punto de Retiro Paso Molino</h4>
            <p class="text-sm text-muted-foreground leading-relaxed">
              <strong>Dirección:</strong> Ángel Salvo 56 (Ferretería al lado de la vía del tren)<br />
              <strong>Lunes a Viernes:</strong> 08:00 a 12:00 y 14:00 a 18:00 hs<br />
              <strong>Sábados:</strong> 08:00 a 13:00 hs<br />
              <span class="text-emerald-700 font-medium">Retiro sin costo de despacho</span>
            </p>
          </div>
          <div>
            <h4 class="font-semibold text-sm mb-3 text-foreground uppercase tracking-wider">Contacto & Ventas</h4>
            <p class="text-sm text-muted-foreground leading-relaxed mb-3">
              Consultas comerciales y cotizaciones personalizadas:<br />
              <strong>Email:</strong> <a href="mailto:dosrodriguezdistribuidora@gmail.com" class="text-primary hover:underline">dosrodriguezdistribuidora@gmail.com</a><br />
              <strong>WhatsApp:</strong> 095 250 673<br />
              Montevideo, Uruguay
            </p>
            <a
              href="/portal"
              class="inline-block text-xs text-primary font-medium underline underline-offset-4 hover:text-primary/80"
            >
              Ingresar al Área de Clientes &rarr;
            </a>
          </div>
        </div>
        <div class="border-t border-border mt-8 pt-4 flex flex-col sm:flex-row items-center justify-between text-xs text-muted-foreground">
          <span>&copy; {new Date().getFullYear()} 2 Rodríguez Distribuidora. Todos los derechos reservados.</span>
          <span class="mt-2 sm:mt-0">Montevideo - Uruguay</span>
        </div>
      </div>
    </footer>

    <!-- WhatsApp Floating Action Button (Prolimpio / Equilimp style) -->
    <aside aria-label="Contacto WhatsApp directo" class="fixed bottom-5 right-5 z-50 flex items-center gap-2 group">
      <span class="hidden sm:inline-flex items-center rounded-full bg-background/95 border border-border shadow-lg px-3 py-1.5 text-xs font-semibold text-foreground backdrop-blur-xs transition-all opacity-0 group-hover:opacity-100 translate-x-2 group-hover:translate-x-0 pointer-events-none">
        ¿Dudas o pedidos? ¡Escribinos!
      </span>
      <a
        href="https://wa.me/59895250673?text=Hola%202%20Rodr%C3%ADguez%20Distribuidora%2C%20quisiera%20hacer%20una%20consulta"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Abrir chat de WhatsApp con 2 Rodríguez Distribuidora"
        class="relative flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-xl hover:bg-[#20ba59] hover:scale-105 active:scale-95 transition-all focus:outline-none focus:ring-4 focus:ring-[#25D366]/40"
      >
        <span class="absolute -top-1 -right-1 flex h-3.5 w-3.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-300 border-2 border-white"></span>
        </span>
        <!-- WhatsApp Official Vector Icon -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
      </a>
    </aside>

    <!-- Mobile Navigation Interactive Controller -->
    <script>
      function setupMobileNav() {
        const toggleBtn = document.getElementById('mobileMenuToggle');
        const menu = document.getElementById('mobileMenu');
        const hamburgerIcon = document.getElementById('hamburgerIcon');
        const closeIcon = document.getElementById('closeIcon');

        if (!toggleBtn || !menu) return;

        function close() {
          menu.classList.add('hidden');
          toggleBtn.setAttribute('aria-expanded', 'false');
          toggleBtn.setAttribute('aria-label', 'Abrir menú de navegación');
          hamburgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        }

        function open() {
          menu.classList.remove('hidden');
          toggleBtn.setAttribute('aria-expanded', 'true');
          toggleBtn.setAttribute('aria-label', 'Cerrar menú de navegación');
          hamburgerIcon?.classList.add('hidden');
          closeIcon?.classList.remove('hidden');
        }

        toggleBtn.onclick = (e) => {
          e.stopPropagation();
          const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
          if (isExpanded) {
            close();
          } else {
            open();
          }
        };

        // Close on outside click
        document.addEventListener('click', (e) => {
          const target = e.target;
          if (target && !menu.contains(target) && !toggleBtn.contains(target)) {
            close();
          }
        });

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            close();
          }
        });

        // Close when clicking any nav link
        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            close();
          });
        });

        // Close when resized to desktop breakpoint
        window.addEventListener('resize', () => {
          if (window.innerWidth >= 768) {
            close();
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupMobileNav);
      } else {
        setupMobileNav();
      }
    </script>
  </body>
</html>
