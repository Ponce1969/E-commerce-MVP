---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/ui/badge.astro';
import Card from '@/components/ui/card.astro';
import catalogData from '@/data/catalog.json';
import { DEPARTMENTS, getDepartmentForCategory } from '@/lib/departments';

const categories = Array.from(new Set(catalogData.map((p) => p.categoria))).sort();
const totalCount = catalogData.length;

const departmentCounts = DEPARTMENTS.map((dept) => {
  const count = catalogData.filter((p) => getDepartmentForCategory(p.categoria).id === dept.id).length;
  return { ...dept, count };
});
---

<BaseLayout title="Catálogo Completo | 2 Rodríguez Distribuidora" currentNav="catalogo">
  <div class="space-y-6">
    <!-- Header -->
    <div class="border-b border-border pb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-4xl font-black tracking-tight text-foreground">
          Catálogo General de Artículos
        </h1>
        <p class="text-sm text-muted-foreground mt-2 max-w-2xl">
          Explore los {totalCount} artículos comercializados por 2 Rodríguez Distribuidora. Si ya cuenta con lista preferencial o desea cotizaciones comerciales por escala, acceda al área de clientes.
        </p>
      </div>
      <a
        href="/portal"
        class="inline-flex items-center justify-center rounded-lg border border-primary/30 bg-primary/5 hover:bg-primary/10 text-primary px-4 py-2.5 text-xs sm:text-sm font-semibold transition-all shrink-0 gap-2"
      >
        <span>Acceso Clientes Mayoristas</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Session Banner (when customer is logged in) -->
    <div id="catalogAuthBanner" class="hidden rounded-xl border border-primary/30 bg-primary/10 p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs sm:text-sm">
      <div class="flex items-center gap-2.5">
        <span class="flex h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
        <span class="font-medium text-foreground">
          Sesión comercial activa como <strong id="catalogUserEmail" class="text-primary font-bold"></strong>. Podés hacer pedidos directos con tus tarifas preferenciales.
        </span>
      </div>
      <a
        href="/portal"
        class="inline-flex items-center justify-center rounded-lg bg-primary text-primary-foreground font-semibold px-3.5 py-2 text-xs shadow-xs hover:bg-primary/90 transition-colors shrink-0 gap-1.5"
      >
        <span>Ir a Mi Carrito / Portal</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Macro-Rubros / Departamentos Tabs -->
    <div class="space-y-2.5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-foreground uppercase tracking-wider">Líneas y Rubros Disponibles:</span>
        <span class="text-xs text-muted-foreground hidden sm:inline">Seleccioná un rubro para separar pañales de químicos</span>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5" id="departmentTabs">
        <button
          type="button"
          data-department="all"
          class="dept-tab flex items-center gap-2.5 p-3 rounded-xl border-2 border-primary bg-primary/10 text-primary font-bold text-xs sm:text-sm text-left transition-all cursor-pointer shadow-xs"
        >
          <span class="text-xl">📦</span>
          <div class="min-w-0">
            <div class="truncate">Todos los Rubros</div>
            <div class="text-[11px] font-normal text-muted-foreground">{totalCount} artículos</div>
          </div>
        </button>

        {departmentCounts.map((dept) => (
          <button
            type="button"
            data-department={dept.id}
            class="dept-tab flex items-center gap-2.5 p-3 rounded-xl border border-border bg-card hover:border-primary/50 text-foreground font-semibold text-xs sm:text-sm text-left transition-all cursor-pointer shadow-xs"
          >
            <span class="text-xl">{dept.icon}</span>
            <div class="min-w-0">
              <div class="truncate">{dept.shortName}</div>
              <div class="text-[11px] font-normal text-muted-foreground">{dept.count} artículos</div>
            </div>
          </button>
        ))}
      </div>
    </div>

    <!-- Filter Bar -->
    <div class="flex flex-col sm:flex-row gap-4 items-center justify-between bg-card p-4 rounded-xl border border-border">
      <div class="w-full sm:w-1/2 relative">
        <input
          type="text"
          id="searchInput"
          placeholder="Buscar por nombre o descripción..."
          class="w-full rounded-lg border border-input bg-background px-4 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary min-h-[44px]"
        />
      </div>

      <div class="w-full sm:w-auto flex items-center gap-3">
        <label for="categoryFilter" class="text-xs font-semibold text-muted-foreground whitespace-nowrap">
          Categoría:
        </label>
        <select
          id="categoryFilter"
          class="w-full sm:w-auto rounded-lg border border-input bg-background px-3 py-2.5 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary min-h-[44px]"
        >
          <option value="">Todas las categorías ({totalCount})</option>
          {categories.map((c) => (
            <option value={c}>{c}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Product Grid -->
    <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {catalogData.map((p) => {
        const dept = getDepartmentForCategory(p.categoria);
        const waMsg = encodeURIComponent(`Hola 2 Rodríguez Distribuidora, quisiera consultar el precio del producto: ${p.nombre} (${p.presentacion || 'estándar'})`);
        return (
          <div
            class="product-card"
            data-name={p.nombre.toLowerCase()}
            data-category={p.categoria}
            data-department={dept.id}
          >
            <Card class="h-full flex flex-col justify-between p-5 hover:border-primary/50 transition-all shadow-xs">
              <div class="space-y-3">
                <!-- Product Preview Box with Department Badge -->
                <div class="relative w-full h-36 rounded-lg bg-muted/20 border border-border/50 flex flex-col items-center justify-center text-muted-foreground/60 gap-1.5 p-3 overflow-hidden">
                  <span class="text-3xl">{dept.icon}</span>
                  <span class="text-[10px] uppercase tracking-wider font-bold text-primary/80">
                    {dept.badge}
                  </span>
                </div>

                <div class="flex items-center justify-between gap-2">
                  <Badge variant="outline" class="text-[11px] font-normal truncate max-w-[180px]">
                    {p.categoria}
                  </Badge>
                  {p.presentacion && (
                    <span class="text-xs font-semibold text-muted-foreground bg-secondary px-2 py-0.5 rounded">
                      {p.presentacion}
                    </span>
                  )}
                </div>
                <h3 class="font-bold text-base text-foreground leading-snug line-clamp-2">
                  {p.nombre}
                </h3>
                <p class="text-xs text-muted-foreground flex items-center gap-1.5">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                  Garantía 2 Rodríguez Distribuidora
                </p>
              </div>

              <!-- Precios Exclusivos Clientes CTA -->
              <div class="pt-4 mt-3 border-t border-border flex items-center justify-between gap-2">
                <a
                  href="/portal"
                  class="text-xs text-muted-foreground flex flex-col group hover:text-primary transition-colors text-left"
                  title="Iniciá sesión para ver tu lista de precios"
                >
                  <span class="font-semibold text-foreground group-hover:text-primary transition-colors">
                    Precios exclusivos
                  </span>
                  <span class="text-[11px] underline decoration-muted-foreground/40 group-hover:decoration-primary">
                    Ingresá para ver precio
                  </span>
                </a>
                <a
                  href={`https://wa.me/59895250673?text=${waMsg}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center rounded-md bg-emerald-600 px-3 py-2 text-xs font-semibold text-white shadow-xs hover:bg-emerald-700 transition-colors gap-1.5 min-h-[38px] shrink-0"
                >
                  Consultar Precio
                </a>
              </div>
            </Card>
          </div>
        );
      })}
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden text-center py-16 space-y-3">
      <p class="text-lg font-semibold text-foreground">No encontramos artículos con esos filtros</p>
      <p class="text-sm text-muted-foreground">Probá con otra palabra o limpiá el filtro de categorías.</p>
    </div>
  </div>

  <!-- Client-side filter script -->
  <script is:inline>
    const searchInput = document.getElementById('searchInput');
    const categoryFilter = document.getElementById('categoryFilter');
    const productCards = document.querySelectorAll('.product-card');
    const emptyState = document.getElementById('emptyState');
    const deptTabs = document.querySelectorAll('.dept-tab');

    // Parse URL params for pre-selected category or department
    const urlParams = new URLSearchParams(window.location.search);
    const initialCategory = urlParams.get('categoria');
    const initialDept = urlParams.get('rubro') || urlParams.get('departamento') || 'all';

    let currentDept = initialDept;

    if (initialCategory && categoryFilter) {
      categoryFilter.value = initialCategory;
    }

    function setActiveTab(deptId) {
      currentDept = deptId;
      deptTabs.forEach((tab) => {
        const isMatch = tab.getAttribute('data-department') === deptId;
        if (isMatch) {
          tab.classList.remove('border-border', 'bg-card', 'text-foreground');
          tab.classList.add('border-2', 'border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
        } else {
          tab.classList.remove('border-2', 'border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
          tab.classList.add('border-border', 'bg-card', 'text-foreground');
        }
      });
    }

    function filterProducts() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      const selectedCategory = categoryFilter?.value || '';
      let visibleCount = 0;

      productCards.forEach((card) => {
        const name = card.getAttribute('data-name') || '';
        const category = card.getAttribute('data-category') || '';
        const cardDept = card.getAttribute('data-department') || '';

        const matchesDept = currentDept === 'all' || cardDept === currentDept;
        const matchesQuery = !query || name.includes(query);
        const matchesCategory = !selectedCategory || category === selectedCategory;

        if (matchesDept && matchesQuery && matchesCategory) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    deptTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const deptId = tab.getAttribute('data-department') || 'all';
        setActiveTab(deptId);
        filterProducts();
      });
    });

    searchInput?.addEventListener('input', filterProducts);
    categoryFilter?.addEventListener('change', filterProducts);

    if (initialDept !== 'all') {
      setActiveTab(initialDept);
    }
    filterProducts();

    // Check customer session to show auth banner
    const customerToken = localStorage.getItem('customer_token');
    const customerEmail = localStorage.getItem('customer_email');
    const authBanner = document.getElementById('catalogAuthBanner');
    const userEmailEl = document.getElementById('catalogUserEmail');
    if (customerToken && authBanner) {
      if (userEmailEl) userEmailEl.textContent = customerEmail || 'Cliente';
      authBanner.classList.remove('hidden');
    }
  </script>
</BaseLayout>
