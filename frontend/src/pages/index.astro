---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/button.astro';
import Badge from '@/components/ui/badge.astro';
import Card from '@/components/ui/card.astro';
import catalogData from '@/data/catalog.json';

const featuredProducts = catalogData.slice(0, 6);
const totalProducts = catalogData.length;
const categories = Array.from(new Set(catalogData.map((p) => p.categoria))).slice(0, 8);
---

<BaseLayout currentNav="home">
  <!-- Hero Section -->
  <section class="py-8 md:py-16 text-center space-y-6">
    <div class="inline-flex items-center gap-2 rounded-full border border-border bg-secondary/60 px-4 py-1.5 text-xs sm:text-sm font-medium text-secondary-foreground mb-2">
      <span class="flex h-2 w-2 rounded-full bg-primary animate-pulse"></span>
      Catálogo Actualizado — 311 Artículos Disponibles
    </div>
    
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-foreground max-w-4xl mx-auto leading-tight">
      Distribución Mayorista de <span class="text-primary">Limpieza y Químicos</span>
    </h1>

    <p class="text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">
      Abastecemos a empresas de limpieza, residenciales, lavanderías y particulares en todo el país. Retiro gratuito en Paso Molino o envíos por cadetería.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-4">
      <Button as="a" href="/catalogo" size="lg" class="w-full sm:w-auto font-semibold">
        Explorar Catálogo Completo
      </Button>
      <Button
        as="a"
        href="https://wa.me/59899549330?text=Hola%202%20Rodriguez%2C%20quisiera%20solicitar%20cotizacion%20de%20articulos"
        target="_blank"
        rel="noopener noreferrer"
        variant="success"
        size="lg"
        class="w-full sm:w-auto font-semibold"
      >
        Pedir Cotización al 099 549 330
      </Button>
      <Button as="a" href="/portal" variant="outline" size="lg" class="w-full sm:w-auto font-semibold">
        Portal Clientes B2B &rarr;
      </Button>
    </div>
  </section>

  <!-- Paso Molino Logistics Banner (Regla 7) -->
  <section id="retiro" class="my-10 rounded-2xl border border-primary/20 bg-primary/5 p-6 sm:p-8">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2">
        <Badge variant="default" class="bg-primary/90 text-primary-foreground font-semibold">
          Pickup Presencial Gratuito
        </Badge>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground">
          Punto de Retiro en Paso Molino, Montevideo
        </h2>
        <p class="text-sm text-muted-foreground max-w-xl">
          Retirá tus pedidos sin costo de envío en nuestro local de Paso Molino. 
          Coordinación rápida por WhatsApp luego de confirmar tu compra.
        </p>
      </div>
      <div class="rounded-xl border border-border bg-card p-4 text-xs sm:text-sm text-foreground space-y-1.5 w-full md:w-auto shadow-sm">
        <div class="font-bold text-primary">Horarios de Atención:</div>
        <div><strong>Lunes a Viernes:</strong> 08:30 a 12:00 y 13:00 a 18:00 hs</div>
        <div><strong>Sábados:</strong> 08:00 a 13:00 hs</div>
        <div class="text-muted-foreground pt-1">Sin mínimo de compra requerido.</div>
      </div>
    </div>
  </section>

  <!-- Categories Grid -->
  <section class="my-12 space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground">Rubros y Categorías</h3>
        <p class="text-sm text-muted-foreground">Líneas de productos formulados para alto rendimiento.</p>
      </div>
      <a href="/catalogo" class="text-sm font-semibold text-primary hover:underline">
        Ver todas &rarr;
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
      {categories.map((cat) => (
        <a
          href={`/catalogo?categoria=${encodeURIComponent(cat)}`}
          class="flex items-center justify-between p-4 rounded-xl border border-border bg-card hover:border-primary hover:shadow-sm transition-all text-sm font-medium text-card-foreground group"
        >
          <span class="truncate">{cat}</span>
          <span class="text-muted-foreground group-hover:text-primary transition-colors">&rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured Products Preview (Precios Ocultos con CTA a WhatsApp) -->
  <section class="my-12 space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground">Artículos Destacados</h3>
        <p class="text-sm text-muted-foreground">Productos de alta rotación para desinfección y limpieza institucional.</p>
      </div>
      <a href="/catalogo" class="text-sm font-semibold text-primary hover:underline">
        Explorar {totalProducts} artículos &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredProducts.map((p) => {
        const waMsg = encodeURIComponent(`Hola 2 Rodríguez, quisiera consultar precio por el artículo: ${p.nombre} (${p.presentacion || 'estándar'})`);
        return (
          <Card class="flex flex-col justify-between p-5 hover:border-primary/50 transition-all">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <Badge variant="outline" class="text-[11px] font-normal truncate max-w-[180px]">
                  {p.categoria}
                </Badge>
                {p.presentacion && (
                  <span class="text-xs font-semibold text-muted-foreground bg-secondary px-2 py-0.5 rounded">
                    {p.presentacion}
                  </span>
                )}
              </div>
              <h4 class="font-bold text-base text-foreground leading-snug line-clamp-2">
                {p.nombre}
              </h4>
              <p class="text-xs text-muted-foreground">
                Proveedor certificado: <strong class="text-foreground">{p.proveedor || '2 Rodríguez'}</strong>
              </p>
            </div>

            <!-- Precios Protegidos (Regla 4): WhatsApp CTA -->
            <div class="pt-5 mt-4 border-t border-border flex items-center justify-between gap-2">
              <div class="text-xs text-muted-foreground flex flex-col">
                <span class="font-medium text-foreground">Precio Protegido</span>
                <span>Aranceles B2B</span>
              </div>
              <a
                href={`https://wa.me/59899549330?text=${waMsg}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-md bg-emerald-600 px-3 py-2 text-xs font-semibold text-white shadow-sm hover:bg-emerald-700 transition-colors gap-1.5 min-h-[38px]"
              >
                Consultar Precio
              </a>
            </div>
          </Card>
        );
      })}
    </div>
  </section>
</BaseLayout>
