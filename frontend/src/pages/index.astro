---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/button.astro';
import Badge from '@/components/ui/badge.astro';
import Card from '@/components/ui/card.astro';
import catalogData from '@/data/catalog.json';

const featuredProducts = catalogData.slice(0, 6);
const totalProducts = catalogData.length;
const categories = Array.from(new Set(catalogData.map((p) => p.categoria))).slice(0, 8);
---

<BaseLayout currentNav="home">
  <!-- Hero Section con Fondos Tenues Corporativos (Azul & Verde de 2 Rodríguez) -->
  <section class="relative my-4 py-12 md:py-20 px-6 sm:px-12 text-center rounded-3xl border border-blue-100 bg-gradient-to-b from-blue-50/50 via-background to-emerald-50/40 overflow-hidden shadow-xs">
    <!-- Luces de Aura Atmosférica Tenue (Mesh Gradients Azul y Verde del Logo) -->
    <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-3/4 h-80 w-80 sm:h-96 sm:w-96 rounded-full bg-blue-500/12 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 right-1/4 h-80 w-80 sm:h-96 sm:w-96 rounded-full bg-emerald-500/12 blur-3xl"></div>
    
    <!-- Sutil Patrón de Cuadrícula / Higiene -->
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(#0b4ca0_1px,transparent_1px)] [background-size:24px_24px] opacity-[0.04]"></div>

    <!-- Contenido del Hero -->
    <div class="relative z-10 max-w-4xl mx-auto space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-200/80 bg-background/90 backdrop-blur-xs px-4 py-1.5 text-xs sm:text-sm font-semibold text-blue-900 dark:text-blue-200 shadow-xs">
        <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Catálogo Mayorista 2026 — 311 Artículos Disponibles
      </div>
      
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-foreground leading-tight">
        Distribución Mayorista de <span class="bg-gradient-to-r from-blue-700 via-blue-600 to-emerald-600 bg-clip-text text-transparent">Limpieza y Químicos</span>
      </h1>

      <p class="text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">
        Abastecemos a empresas de limpieza, comercios, residenciales, lavanderías y particulares en todo Uruguay. Retiro prioritario sin costo en Paso Molino o envíos ágiles a todo el país.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-4">
        <Button as="a" href="/catalogo" size="lg" class="w-full sm:w-auto font-semibold shadow-xs">
          Explorar Catálogo Completo
        </Button>
        <Button
          as="a"
          href="https://wa.me/59895250673?text=Hola%202%20Rodriguez%2C%20quisiera%20solicitar%20cotizacion%20de%20articulos"
          target="_blank"
          rel="noopener noreferrer"
          variant="success"
          size="lg"
          class="w-full sm:w-auto font-semibold shadow-xs"
        >
          Pedir Cotización al 095 250 673
        </Button>
        <Button as="a" href="/portal" variant="outline" size="lg" class="w-full sm:w-auto font-semibold bg-background/80 hover:bg-background">
          Acceso Clientes Mayoristas &rarr;
        </Button>
      </div>

      <!-- Micro Badges de Confianza Corporativa -->
      <div class="pt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs text-muted-foreground border-t border-border/60 max-w-3xl mx-auto">
        <div class="flex items-center justify-center gap-1.5 font-medium">
          <span class="text-emerald-600 font-bold">✓</span> Stock Permanente
        </div>
        <div class="flex items-center justify-center gap-1.5 font-medium">
          <span class="text-emerald-600 font-bold">✓</span> Retiro Paso Molino $0
        </div>
        <div class="flex items-center justify-center gap-1.5 font-medium">
          <span class="text-emerald-600 font-bold">✓</span> Bonificación BROU
        </div>
        <div class="flex items-center justify-center gap-1.5 font-medium">
          <span class="text-emerald-600 font-bold">✓</span> Facturación Oficial RUT
        </div>
      </div>
    </div>
  </section>

  <!-- Paso Molino Logistics Banner (Regla 7) -->
  <section id="retiro" class="my-10 rounded-2xl border border-primary/20 bg-primary/5 p-6 sm:p-8">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2">
        <Badge variant="default" class="bg-primary/90 text-primary-foreground font-semibold">
          Pickup Presencial Gratuito
        </Badge>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground">
          Punto de Retiro: Ángel Salvo 56 (Paso Molino)
        </h2>
        <p class="text-sm text-muted-foreground max-w-xl">
          Retirá tus pedidos sin costo de envío en nuestro punto de entrega de <strong>Ángel Salvo 56</strong> (Ferretería al lado de la vía del tren).
          Coordinación inmediata por WhatsApp o correo luego de confirmar tu compra.
        </p>
      </div>
      <div class="rounded-xl border border-border bg-card p-4 text-xs sm:text-sm text-foreground space-y-1.5 w-full md:w-auto shadow-sm">
        <div class="font-bold text-primary">Horarios de Atención:</div>
        <div><strong>Lunes a Viernes:</strong> 08:00 a 12:00 y 14:00 a 18:00 hs</div>
        <div><strong>Sábados:</strong> 08:00 a 13:00 hs</div>
        <div class="text-muted-foreground pt-1">Sin mínimo de compra requerido.</div>
      </div>
    </div>
  </section>

  <!-- Formas de Pago Transparentes -->
  <section class="my-12 rounded-2xl border border-border bg-card p-6 sm:p-8 space-y-6 shadow-xs">
    <div class="text-center max-w-2xl mx-auto space-y-2">
      <Badge variant="outline" class="text-xs font-semibold text-primary border-primary/30 bg-primary/5">
        Transparencia Comercial
      </Badge>
      <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-foreground">
        Formas de Pago Pensadas para tu Crecimiento
      </h2>
      <p class="text-sm text-muted-foreground leading-relaxed">
        Impulsamos tu negocio con opciones de pago flexibles, transparentes y sin sorpresas.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
      <!-- Opción BROU / Redes -->
      <div class="rounded-xl border-2 border-emerald-500/60 bg-emerald-50/20 dark:bg-emerald-950/10 p-5 flex flex-col justify-between space-y-4">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-1.5 font-bold text-sm text-foreground">
              <span class="text-xl">🏦</span> Transferencia Bancaria BROU & Redes
            </span>
            <span class="text-[11px] font-bold text-emerald-700 dark:text-emerald-300 bg-emerald-100 dark:bg-emerald-900/40 px-2.5 py-0.5 rounded-full">
              Precio Bonificado
            </span>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed">
            La opción más conveniente y económica para empresas y comercios. Sin cargos financieros adicionales y con acreditación directa.
          </p>
          <div class="rounded-lg bg-background/80 border border-border p-3 text-xs space-y-1">
            <div><strong>Titular:</strong> Mariana Moreira</div>
            <div><strong>Caja de Ahorro BROU:</strong> <span class="font-mono font-bold text-foreground">110975226-00001</span></div>
            <div><strong>Redes (Abitab / Redpagos):</strong> <span class="font-mono font-bold text-foreground">601-0551790</span></div>
          </div>
        </div>
        <div class="text-[11px] text-emerald-700 dark:text-emerald-400 font-semibold flex items-center gap-1 pt-2 border-t border-emerald-500/20">
          <span>✓</span> Mejor precio garantizado de lista
        </div>
      </div>

      <!-- Opción Mercado Pago -->
      <div class="rounded-xl border border-border bg-background p-5 flex flex-col justify-between space-y-4">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-1.5 font-bold text-sm text-foreground">
              <span class="text-xl">💳</span> Mercado Pago Oficial
            </span>
            <span class="text-[11px] font-semibold text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/40 px-2.5 py-0.5 rounded-full border border-blue-200 dark:border-blue-800">
              Hasta 12 Cuotas
            </span>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Financiación en cuotas con tarjetas de crédito y débito bajo plataforma 100% segura. Ideal para compras mayores o diferir pagos.
          </p>
          <div class="rounded-lg bg-card border border-border p-3 text-xs space-y-1">
            <div class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span>Tarjetas Visa, Mastercard, Oca, Cabal y Lider</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span>Protección y garantía en cada operación</span>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-[11px] pt-1 border-t border-border/60">
              <span>* Aplica arancel por servicio financiero de la pasarela (+7% aprox.)</span>
            </div>
          </div>
        </div>
        <div class="text-[11px] text-muted-foreground font-medium flex items-center gap-1 pt-2 border-t border-border">
          <span>ℹ</span> Transparencia total detallada antes de abonar
        </div>
      </div>
    </div>
  </section>

  <!-- Categories Grid -->
  <section class="my-12 space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground">Rubros y Categorías</h3>
        <p class="text-sm text-muted-foreground">Líneas de productos formulados para alto rendimiento.</p>
      </div>
      <a href="/catalogo" class="text-sm font-semibold text-primary hover:underline">
        Ver todas &rarr;
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
      {categories.map((cat) => (
        <a
          href={`/catalogo?categoria=${encodeURIComponent(cat)}`}
          class="flex items-center justify-between p-4 rounded-xl border border-border bg-card hover:border-primary hover:shadow-sm transition-all text-sm font-medium text-card-foreground group"
        >
          <span class="truncate">{cat}</span>
          <span class="text-muted-foreground group-hover:text-primary transition-colors">&rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured Products Preview (Precios Ocultos con CTA a WhatsApp) -->
  <section class="my-12 space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground">Artículos Destacados</h3>
        <p class="text-sm text-muted-foreground">Productos de alta rotación para desinfección y limpieza institucional.</p>
      </div>
      <a href="/catalogo" class="text-sm font-semibold text-primary hover:underline">
        Explorar {totalProducts} artículos &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredProducts.map((p) => {
        const waMsg = encodeURIComponent(`Hola 2 Rodríguez, quisiera consultar precio por el artículo: ${p.nombre} (${p.presentacion || 'estándar'})`);
        return (
          <Card class="flex flex-col justify-between p-5 hover:border-primary/50 transition-all">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <Badge variant="outline" class="text-[11px] font-normal truncate max-w-[180px]">
                  {p.categoria}
                </Badge>
                {p.presentacion && (
                  <span class="text-xs font-semibold text-muted-foreground bg-secondary px-2 py-0.5 rounded">
                    {p.presentacion}
                  </span>
                )}
              </div>
              <h4 class="font-bold text-base text-foreground leading-snug line-clamp-2">
                {p.nombre}
              </h4>
              <p class="text-xs text-muted-foreground flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                Stock garantizado para entrega o retiro
              </p>
            </div>

            <!-- Precios Protegidos (Regla 4): WhatsApp CTA -->
            <div class="pt-5 mt-4 border-t border-border flex items-center justify-between gap-2">
              <div class="text-xs text-muted-foreground flex flex-col">
                <span class="font-medium text-foreground">Precio Protegido</span>
                <span>Precios Mayoristas</span>
              </div>
              <a
                href={`https://wa.me/59895250673?text=${waMsg}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-md bg-emerald-600 px-3 py-2 text-xs font-semibold text-white shadow-sm hover:bg-emerald-700 transition-colors gap-1.5 min-h-[38px]"
              >
                Consultar Precio
              </a>
            </div>
          </Card>
        );
      })}
    </div>
  </section>
</BaseLayout>
