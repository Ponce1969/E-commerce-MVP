---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Backoffice Mariana | 2 Rodríguez Distribuidora" currentNav="admin">
  <div class="space-y-6">
    <!-- Admin Header -->
    <div class="border-b border-border pb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-foreground flex items-center gap-3">
          Panel de Administración
          <span class="text-xs bg-primary/10 text-primary border border-primary/20 px-2.5 py-0.5 rounded-full font-semibold">
            Mariana
          </span>
        </h1>
        <p class="text-sm text-muted-foreground mt-1">
          Gestión centralizada del catálogo maestro, control de márgenes confidenciales y emisión de presupuestos.
        </p>
      </div>

      <div id="adminUserBar" class="hidden flex-wrap items-center gap-2.5">
        <button
          id="exportInventoryBtn"
          class="inline-flex items-center justify-center rounded-lg border border-input bg-background px-3 py-2 text-xs font-semibold text-foreground shadow-xs hover:bg-accent hover:border-primary transition-colors min-h-[40px] gap-1.5 cursor-pointer"
          title="Descargar catálogo completo con stock en CSV compatible con Excel"
        >
          <span>📥 Exportar Excel / CSV</span>
        </button>
        <button
          id="openImportStockBtn"
          class="inline-flex items-center justify-center rounded-lg border border-input bg-background px-3 py-2 text-xs font-semibold text-foreground shadow-xs hover:bg-accent hover:border-primary transition-colors min-h-[40px] gap-1.5 cursor-pointer"
          title="Subir archivo Excel/CSV para actualizar el inventario masivamente"
        >
          <span>📤 Cargar Stock Masivo</span>
        </button>
        <button
          id="openQuoteModalBtn"
          class="inline-flex items-center justify-center rounded-lg bg-emerald-600 px-3.5 py-2 text-xs font-semibold text-white shadow hover:bg-emerald-700 transition-colors min-h-[40px] gap-2 cursor-pointer"
        >
          <span>Emitir Presupuesto PDF</span>
        </button>
        <button
          id="openNewProductBtn"
          class="inline-flex items-center justify-center rounded-lg bg-primary px-3.5 py-2 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-colors min-h-[40px] cursor-pointer"
        >
          + Nuevo Artículo
        </button>
        <button
          id="adminLogoutBtn"
          class="inline-flex items-center justify-center rounded-lg border border-input bg-background px-3 py-2 text-xs font-medium text-muted-foreground hover:bg-accent hover:text-foreground transition-colors min-h-[40px] cursor-pointer"
        >
          Salir
        </button>
      </div>
    </div>

    <!-- Admin Login (if unauthenticated) -->
    <div id="adminLoginView" class="max-w-md mx-auto my-12 p-6 sm:p-8 rounded-2xl border border-border bg-card shadow-sm space-y-6">
      <div class="text-center space-y-1">
        <h2 class="text-xl font-bold text-foreground">Acceso Administradora</h2>
        <p class="text-xs text-muted-foreground">
          Ingrese con su cuenta de Mariana 2 Rodríguez.
        </p>
      </div>

      <form id="adminLoginForm" class="space-y-4">
        <div class="space-y-1">
          <label for="adminEmail" class="text-xs font-semibold text-foreground">Usuario / Correo</label>
          <input
            type="email"
            id="adminEmail"
            required
            value="mariana@2rodriguez.uy"
            class="w-full rounded-lg border border-input bg-background px-3.5 py-2 text-sm text-foreground min-h-[44px]"
          />
        </div>

        <div class="space-y-1">
          <label for="adminPassword" class="text-xs font-semibold text-foreground">Contraseña</label>
          <input
            type="password"
            id="adminPassword"
            required
            value="Admin2Rodriguez!2026"
            class="w-full rounded-lg border border-input bg-background px-3.5 py-2 text-sm text-foreground min-h-[44px]"
          />
        </div>

        <div id="adminLoginError" class="hidden rounded-lg bg-destructive/10 border border-destructive/20 p-3 text-xs text-destructive"></div>

        <button
          type="submit"
          class="w-full inline-flex items-center justify-center rounded-lg bg-primary py-2.5 text-sm font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-colors min-h-[44px] cursor-pointer"
        >
          Acceder al Backoffice
        </button>
      </form>
    </div>

    <!-- Admin Dashboard (when authenticated) -->
    <div id="adminDashboard" class="hidden space-y-6">
      <!-- Admin Tab Switcher -->
      <div class="flex items-center gap-2 border-b border-border pb-3">
        <button
          id="tabCatalogBtn"
          onclick="window.switchAdminTab('catalog')"
          class="inline-flex items-center gap-2 px-4 py-2 text-xs font-bold rounded-lg transition-colors cursor-pointer bg-primary text-primary-foreground shadow-xs"
        >
          <span>📦 Catálogo & Inventario</span>
        </button>
        <button
          id="tabFinancesBtn"
          onclick="window.switchAdminTab('finances')"
          class="inline-flex items-center gap-2 px-4 py-2 text-xs font-bold rounded-lg transition-colors cursor-pointer bg-muted text-muted-foreground hover:text-foreground hover:bg-muted/80"
        >
          <span>📊 Mini-Contabilidad & Rentabilidad</span>
        </button>
      </div>

      <!-- Catalog Section -->
      <div id="catalogSection" class="space-y-6">
        <!-- 5 Top KPI Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
        <div class="rounded-xl border border-border bg-card p-4 shadow-xs">
          <div class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Artículos Maestros</div>
          <div id="kpiTotalProducts" class="text-2xl sm:text-3xl font-black text-foreground mt-1">311</div>
          <div class="text-[11px] text-muted-foreground mt-0.5">Catálogo consolidado</div>
        </div>

        <div class="rounded-xl border border-destructive/30 bg-destructive/5 p-4 shadow-xs cursor-pointer hover:bg-destructive/10 transition-colors" onclick="window.applyFilter('low_stock')">
          <div class="text-xs font-semibold text-destructive uppercase tracking-wider flex items-center justify-between">
            <span>Stock Crítico</span>
            <span class="w-2 h-2 rounded-full bg-destructive animate-pulse"></span>
          </div>
          <div id="kpiCriticalStock" class="text-2xl sm:text-3xl font-black text-destructive mt-1">0</div>
          <div class="text-[11px] text-destructive/80 mt-0.5">Alertas de reposición</div>
        </div>

        <div class="rounded-xl border border-border bg-card p-4 shadow-xs">
          <div class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Fichas Incompletas</div>
          <div id="kpiIncomplete" class="text-2xl sm:text-3xl font-black text-amber-600 mt-1">57</div>
          <div class="text-[11px] text-muted-foreground mt-0.5">Requieren costo/recargo</div>
        </div>

        <div class="rounded-xl border border-border bg-card p-4 shadow-xs">
          <div class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Proveedor Moizo</div>
          <div id="kpiMoizo" class="text-2xl sm:text-3xl font-black text-primary mt-1">49</div>
          <div class="text-[11px] text-muted-foreground mt-0.5">Artículos de línea directa</div>
        </div>

        <div class="rounded-xl border border-border bg-card p-4 shadow-xs">
          <div class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Conflictos Históricos</div>
          <div id="kpiConflicts" class="text-2xl sm:text-3xl font-black text-destructive mt-1">19</div>
          <div class="text-[11px] text-muted-foreground mt-0.5">Márgenes protegidos intactos</div>
        </div>
      </div>

      <!-- Filters Bar -->
      <div class="flex flex-col sm:flex-row gap-3 items-center justify-between bg-card p-4 rounded-xl border border-border">
        <input
          type="text"
          id="adminSearchInput"
          placeholder="Buscar por ID o nombre del producto..."
          class="w-full sm:w-80 rounded-lg border border-input bg-background px-3.5 py-2 text-xs sm:text-sm text-foreground focus:ring-2 focus:ring-primary min-h-[40px]"
        />

        <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
          <button
            onclick="window.applyFilter('all')"
            class="filter-pill rounded-full border border-border bg-background px-3 py-1 text-xs font-semibold hover:border-primary cursor-pointer active"
            data-filter="all"
          >
            Todos
          </button>
          <button
            onclick="window.applyFilter('low_stock')"
            class="filter-pill rounded-full border border-destructive/40 bg-destructive/10 text-destructive px-3 py-1 text-xs font-bold hover:bg-destructive/20 cursor-pointer"
            data-filter="low_stock"
          >
            Stock Crítico (<span id="lowStockPillCount">0</span>)
          </button>
          <button
            onclick="window.applyFilter('conflicts')"
            class="filter-pill rounded-full border border-destructive/30 bg-destructive/5 text-destructive px-3 py-1 text-xs font-semibold hover:bg-destructive/10 cursor-pointer"
            data-filter="conflicts"
          >
            19 Conflictos
          </button>
          <button
            onclick="window.applyFilter('incomplete')"
            class="filter-pill rounded-full border border-amber-300 bg-amber-50 text-amber-800 px-3 py-1 text-xs font-semibold hover:bg-amber-100 cursor-pointer"
            data-filter="incomplete"
          >
            Incompletos
          </button>
          <button
            onclick="window.applyFilter('moizo')"
            class="filter-pill rounded-full border border-primary/30 bg-primary/5 text-primary px-3 py-1 text-xs font-semibold hover:bg-primary/10 cursor-pointer"
            data-filter="moizo"
          >
            Moizo (49)
          </button>
          <button
            onclick="window.applyFilter('published')"
            class="filter-pill rounded-full border border-emerald-300 bg-emerald-50 text-emerald-800 px-3 py-1 text-xs font-semibold hover:bg-emerald-100 cursor-pointer"
            data-filter="published"
          >
            Publicados
          </button>

          <div class="flex items-center gap-1.5 pl-2 border-l border-border">
            <label for="adminProviderSelect" class="text-xs font-semibold text-muted-foreground whitespace-nowrap">Proveedor:</label>
            <select
              id="adminProviderSelect"
              class="rounded-lg border border-input bg-background px-2.5 py-1 text-xs font-semibold text-foreground hover:border-primary cursor-pointer min-h-[32px]"
            >
              <option value="">Todos los Proveedores</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Tabular Interface (Modernized Table) -->
      <div class="rounded-xl border border-border bg-card overflow-hidden shadow-xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="border-b border-border bg-secondary/50 font-semibold text-muted-foreground uppercase tracking-wider">
              <tr>
                <th class="py-3 px-3 w-12 text-center">ID</th>
                <th class="py-3 px-3">Artículo / Categoría</th>
                <th class="py-3 px-3">Pres.</th>
                <th class="py-3 px-3">Proveedor</th>
                <th class="py-3 px-3 text-center">Inventario</th>
                <th class="py-3 px-3">Precios por Lista</th>
                <th class="py-3 px-3 text-center">Publicación</th>
                <th class="py-3 px-3 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody id="productsTableBody" class="divide-y divide-border">
              <tr>
                <td colspan="8" class="py-12 text-center text-muted-foreground">
                  Cargando catálogo administrativo...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div> <!-- Close catalogSection -->

    <!-- Finances & Profitability Section -->
    <div id="financesSection" class="hidden space-y-6">
      <!-- Controls: Period Selector & Add Expense -->
      <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between bg-card p-4 rounded-xl border border-border shadow-xs">
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
          <span class="text-xs font-bold text-foreground">Período Contable:</span>
          <select
            id="financesMonthSelect"
            class="rounded-lg border border-input bg-background px-3 py-1.5 text-xs font-semibold text-foreground hover:border-primary cursor-pointer min-h-[36px]"
          >
            <option value="1">Enero</option>
            <option value="2">Febrero</option>
            <option value="3">Marzo</option>
            <option value="4">Abril</option>
            <option value="5">Mayo</option>
            <option value="6">Junio</option>
            <option value="7">Julio</option>
            <option value="8">Agosto</option>
            <option value="9">Setiembre</option>
            <option value="10">Octubre</option>
            <option value="11">Noviembre</option>
            <option value="12">Diciembre</option>
          </select>
          <select
            id="financesYearSelect"
            class="rounded-lg border border-input bg-background px-3 py-1.5 text-xs font-semibold text-foreground hover:border-primary cursor-pointer min-h-[36px]"
          >
            <option value="2026">2026</option>
            <option value="2025">2025</option>
          </select>
          <button
            id="refreshFinancesBtn"
            class="rounded-lg border border-input bg-background px-3 py-1.5 text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-accent min-h-[36px] cursor-pointer"
          >
            Actualizar
          </button>
        </div>

        <button
          id="openExpenseModalBtn"
          class="inline-flex items-center justify-center rounded-lg bg-emerald-600 px-4 py-2 text-xs font-bold text-white shadow hover:bg-emerald-700 transition-colors min-h-[36px] gap-1.5 cursor-pointer"
        >
          + Registrar Gasto
        </button>
      </div>

      <!-- Financial KPI Cards -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="rounded-xl border border-border bg-card p-4 shadow-xs">
          <div class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Facturación Bruta</div>
          <div id="kpiGrossRevenue" class="text-2xl sm:text-3xl font-black text-foreground mt-1">$0.00</div>
          <div id="kpiOrdersCount" class="text-[11px] text-muted-foreground mt-0.5">0 pedidos en el mes</div>
        </div>

        <div class="rounded-xl border border-border bg-card p-4 shadow-xs">
          <div class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Costo Mercadería (COGS)</div>
          <div id="kpiCogs" class="text-2xl sm:text-3xl font-black text-amber-600 mt-1">$0.00</div>
          <div class="text-[11px] text-muted-foreground mt-0.5">Costo con IVA de ítems vendidos</div>
        </div>

        <div class="rounded-xl border border-border bg-card p-4 shadow-xs">
          <div class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Gastos Operativos</div>
          <div id="kpiTotalExpenses" class="text-2xl sm:text-3xl font-black text-destructive mt-1">$0.00</div>
          <div class="text-[11px] text-muted-foreground mt-0.5">Alquiler, fletes, embalajes</div>
        </div>

        <div class="rounded-xl border border-emerald-500/30 bg-emerald-50/40 dark:bg-emerald-950/20 p-4 shadow-xs">
          <div class="text-xs font-bold text-emerald-800 dark:text-emerald-300 uppercase tracking-wider flex items-center justify-between">
            <span>Ganancia Neta</span>
            <span id="kpiMarginPctBadge" class="text-[10px] bg-emerald-500/20 px-2 py-0.5 rounded-full font-bold">0% margen</span>
          </div>
          <div id="kpiNetProfit" class="text-2xl sm:text-3xl font-black text-emerald-700 dark:text-emerald-400 mt-1">$0.00</div>
          <div id="kpiGrossMargin" class="text-[11px] text-muted-foreground mt-0.5">Margen bruto: $0.00</div>
        </div>
      </div>

      <!-- Profitability Chart (Native SVG) -->
      <div class="rounded-xl border border-border bg-card p-5 shadow-xs space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-border pb-3">
          <div>
            <h3 class="text-sm font-bold text-foreground">Evolución de Rentabilidad (Últimos 6 Meses)</h3>
            <p class="text-xs text-muted-foreground">Comparativa mensual entre Facturación, Gastos y Ganancia Neta real.</p>
          </div>
          <div class="flex items-center gap-4 text-xs">
            <span class="inline-flex items-center gap-1.5 font-medium text-foreground">
              <span class="w-3 h-3 rounded-xs bg-blue-600 inline-block"></span> Facturación
            </span>
            <span class="inline-flex items-center gap-1.5 font-medium text-foreground">
              <span class="w-3 h-3 rounded-xs bg-rose-500 inline-block"></span> Gastos
            </span>
            <span class="inline-flex items-center gap-1.5 font-medium text-foreground">
              <span class="w-3 h-3 rounded-xs bg-emerald-600 inline-block"></span> Ganancia Neta
            </span>
          </div>
        </div>

        <!-- SVG Chart Container -->
        <div id="financialChartContainer" class="w-full overflow-x-auto py-2">
          <svg id="financialSvgChart" viewBox="0 0 680 220" class="w-full min-w-[500px] h-48 sm:h-56">
            <!-- Rendered via JS -->
          </svg>
        </div>
      </div>

      <!-- Expenses Table -->
      <div class="rounded-xl border border-border bg-card overflow-hidden shadow-xs space-y-3 p-4">
        <div class="flex items-center justify-between border-b border-border pb-2">
          <div>
            <h3 class="text-sm font-bold text-foreground">Registro de Gastos del Mes</h3>
            <p class="text-xs text-muted-foreground">Detalle de egresos y costos fijos asentados.</p>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="border-b border-border bg-secondary/50 font-semibold text-muted-foreground uppercase tracking-wider">
              <tr>
                <th class="py-2.5 px-3">Fecha</th>
                <th class="py-2.5 px-3">Categoría</th>
                <th class="py-2.5 px-3">Descripción</th>
                <th class="py-2.5 px-3 text-right">Monto</th>
                <th class="py-2.5 px-3 text-right">Acción</th>
              </tr>
            </thead>
            <tbody id="expensesTableBody" class="divide-y divide-border">
              <tr>
                <td colspan="5" class="py-8 text-center text-muted-foreground">
                  Cargando gastos del período...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div> <!-- Close financesSection -->
  </div> <!-- Close adminDashboard -->

    <!-- Modal: Edit Prices -->
    <div id="priceModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="w-full max-w-md rounded-2xl border border-border bg-card p-6 shadow-xl space-y-4">
        <div class="flex items-center justify-between border-b border-border pb-2">
          <h3 class="font-bold text-foreground text-sm">Editar Condiciones de Precio</h3>
          <button onclick="document.getElementById('priceModal').classList.add('hidden')" class="text-muted-foreground text-lg cursor-pointer">&times;</button>
        </div>

        <div class="space-y-1">
          <div id="priceModalProdName" class="font-bold text-sm text-foreground"></div>
          <div class="text-xs text-muted-foreground">Ajuste de costo con IVA y margen de recargo en Decimal.</div>
        </div>

        <form id="priceEditForm" class="space-y-3">
          <input type="hidden" id="editProdId" />
          
          <div class="space-y-1">
            <label class="text-xs font-semibold text-foreground">Lista Comercial</label>
            <select id="editListId" class="w-full rounded border border-input bg-background p-2 text-xs">
              <option value="1">Empresas / Limpieza</option>
              <option value="2">Residenciales</option>
              <option value="3">Lavandería profesional</option>
              <option value="4">Lavandería domiciliaria</option>
              <option value="5">Automotriz</option>
            </select>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1">
              <label class="text-xs font-semibold text-foreground">Costo c/IVA ($)</label>
              <input type="number" step="0.01" id="editCost" required class="w-full rounded border border-input bg-background p-2 text-xs" />
            </div>
            <div class="space-y-1">
              <label class="text-xs font-semibold text-foreground">Recargo (%)</label>
              <input type="number" step="0.0001" id="editMarkup" required class="w-full rounded border border-input bg-background p-2 text-xs" />
            </div>
          </div>

          <div class="rounded-lg bg-secondary/50 p-3 text-xs flex justify-between items-center">
            <span class="text-muted-foreground">Precio Venta Resultante:</span>
            <span id="previewCalculatedPrice" class="font-bold text-primary text-sm">$0.00</span>
          </div>

          <button
            type="submit"
            class="w-full rounded-lg bg-primary py-2 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-colors min-h-[40px] cursor-pointer"
          >
            Guardar Condición de Precio
          </button>
        </form>
      </div>
    </div>

    <!-- Modal: New Product -->
    <div id="newProductModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="w-full max-w-md rounded-2xl border border-border bg-card p-6 shadow-xl space-y-4">
        <div class="flex items-center justify-between border-b border-border pb-2">
          <h3 class="font-bold text-foreground text-sm">Alta de Producto Maestro</h3>
          <button onclick="document.getElementById('newProductModal').classList.add('hidden')" class="text-muted-foreground text-lg cursor-pointer">&times;</button>
        </div>

        <form id="newProductForm" class="space-y-3">
          <div class="space-y-1">
            <label class="text-xs font-semibold text-foreground">Nombre Comercial</label>
            <input type="text" id="newProdName" required placeholder="Ej: Detergente Multiuso 2 Rodríguez" class="w-full rounded border border-input bg-background p-2 text-xs" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1">
              <label class="text-xs font-semibold text-foreground">Presentación</label>
              <input type="text" id="newProdPres" placeholder="Ej: 5 L, Bidón 10 L" class="w-full rounded border border-input bg-background p-2 text-xs" />
            </div>
            <div class="space-y-1">
              <label class="text-xs font-semibold text-foreground">Proveedor</label>
              <input type="text" id="newProdProv" placeholder="Ej: Moizo, Gabriel" class="w-full rounded border border-input bg-background p-2 text-xs" />
            </div>
          </div>

          <div class="space-y-1">
            <label class="text-xs font-semibold text-foreground">Categoría</label>
            <input type="text" id="newProdCat" value="Limpieza General" class="w-full rounded border border-input bg-background p-2 text-xs" />
          </div>

          <button
            type="submit"
            class="w-full rounded-lg bg-primary py-2 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-colors min-h-[40px] cursor-pointer"
          >
            Dar de Alta
          </button>
        </form>
      </div>
    </div>

    <!-- Modal: Presupuesto PDF -->
    <div id="quoteModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
