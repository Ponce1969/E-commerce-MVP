---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Backoffice Mariana | 2 Rodríguez Distribuidora" currentNav="admin">
  <div class="space-y-6">
    <!-- Admin Header -->
    <div class="border-b border-border pb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-foreground flex items-center gap-3">
          Panel de Administración
          <span class="text-xs bg-primary/10 text-primary border border-primary/20 px-2.5 py-0.5 rounded-full font-semibold">
            Mariana
          </span>
        </h1>
        <p class="text-sm text-muted-foreground mt-1">
          Gestión centralizada del catálogo maestro, control de márgenes confidenciales y emisión de presupuestos.
        </p>
      </div>

      <div id="adminUserBar" class="hidden flex-wrap items-center gap-2.5">
        <button
          id="exportInventoryBtn"
          class="inline-flex items-center justify-center rounded-lg border border-input bg-background px-3 py-2 text-xs font-semibold text-foreground shadow-xs hover:bg-accent hover:border-primary transition-colors min-h-[40px] gap-1.5 cursor-pointer"
          title="Descargar catálogo completo con stock en CSV compatible con Excel"
        >
          <span>📥 Exportar Excel / CSV</span>
        </button>
        <button
          id="openImportStockBtn"
          class="inline-flex items-center justify-center rounded-lg border border-input bg-background px-3 py-2 text-xs font-semibold text-foreground shadow-xs hover:bg-accent hover:border-primary transition-colors min-h-[40px] gap-1.5 cursor-pointer"
          title="Subir archivo Excel/CSV para actualizar el inventario masivamente"
        >
          <span>📤 Cargar Stock Masivo</span>
        </button>
        <button
          id="openQuoteModalBtn"
          class="inline-flex items-center justify-center rounded-lg bg-emerald-600 px-3.5 py-2 text-xs font-semibold text-white shadow hover:bg-emerald-700 transition-colors min-h-[40px] gap-2 cursor-pointer"
        >
          <span>Emitir Presupuesto PDF</span>
        </button>
        <button
          id="openNewProductBtn"
          class="inline-flex items-center justify-center rounded-lg bg-primary px-3.5 py-2 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-colors min-h-[40px] cursor-pointer"
        >
          + Nuevo Artículo
        </button>
        <button
          id="adminLogoutBtn"
          class="inline-flex items-center justify-center rounded-lg border border-input bg-background px-3 py-2 text-xs font-medium text-muted-foreground hover:bg-accent hover:text-foreground transition-colors min-h-[40px] cursor-pointer"
        >
          Salir
        </button>
      </div>
    </div>

    <!-- Admin Login (if unauthenticated) -->
    <div id="adminLoginView" class="max-w-md mx-auto my-12 p-6 sm:p-8 rounded-2xl border border-border bg-card shadow-sm space-y-6">
      <div class="text-center space-y-1">
        <h2 class="text-xl font-bold text-foreground">Acceso Administradora</h2>
        <p class="text-xs text-muted-foreground">
          Ingrese con su cuenta de Mariana 2 Rodríguez.
        </p>
      </div>

      <form id="adminLoginForm" class="space-y-4">
        <div class="space-y-1">
          <label for="adminEmail" class="text-xs font-semibold text-foreground">Usuario / Correo</label>
          <input
            type="email"
            id="adminEmail"
            required
            value="mariana@2rodriguez.uy"
            class="w-full rounded-lg border border-input bg-background px-3.5 py-2 text-sm text-foreground min-h-[44px]"
          />
        </div>

        <div class="space-y-1">
          <label for="adminPassword" class="text-xs font-semibold text-foreground">Contraseña</label>
          <input
            type="password"
            id="adminPassword"
            required
            value="Admin2Rodriguez!2026"
            class="w-full rounded-lg border border-input bg-background px-3.5 py-2 text-sm text-foreground min-h-[44px]"
          />
        </div>

        <div id="adminLoginError" class="hidden rounded-lg bg-destructive/10 border border-destructive/20 p-3 text-xs text-destructive"></div>

        <button
          type="submit"
          class="w-full inline-flex items-center justify-center rounded-lg bg-primary py-2.5 text-sm font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-colors min-h-[44px] cursor-pointer"
        >
          Acceder al Backoffice
        </button>
      </form>
    </div>

    <!-- Admin Dashboard (when authenticated) -->
    <div id="adminDashboard" class="hidden space-y-6">
      <!-- 5 Top KPI Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
        <div class="rounded-xl border border-border bg-card p-4 shadow-xs">
          <div class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Artículos Maestros</div>
          <div id="kpiTotalProducts" class="text-2xl sm:text-3xl font-black text-foreground mt-1">311</div>
          <div class="text-[11px] text-muted-foreground mt-0.5">Catálogo consolidado</div>
        </div>

        <div class="rounded-xl border border-destructive/30 bg-destructive/5 p-4 shadow-xs cursor-pointer hover:bg-destructive/10 transition-colors" onclick="window.applyFilter('low_stock')">
          <div class="text-xs font-semibold text-destructive uppercase tracking-wider flex items-center justify-between">
            <span>Stock Crítico</span>
            <span class="w-2 h-2 rounded-full bg-destructive animate-pulse"></span>
          </div>
          <div id="kpiCriticalStock" class="text-2xl sm:text-3xl font-black text-destructive mt-1">0</div>
          <div class="text-[11px] text-destructive/80 mt-0.5">Alertas de reposición</div>
        </div>

        <div class="rounded-xl border border-border bg-card p-4 shadow-xs">
          <div class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Fichas Incompletas</div>
          <div id="kpiIncomplete" class="text-2xl sm:text-3xl font-black text-amber-600 mt-1">57</div>
          <div class="text-[11px] text-muted-foreground mt-0.5">Requieren costo/recargo</div>
        </div>

        <div class="rounded-xl border border-border bg-card p-4 shadow-xs">
          <div class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Proveedor Moizo</div>
          <div id="kpiMoizo" class="text-2xl sm:text-3xl font-black text-primary mt-1">49</div>
          <div class="text-[11px] text-muted-foreground mt-0.5">Artículos de línea directa</div>
        </div>

        <div class="rounded-xl border border-border bg-card p-4 shadow-xs">
          <div class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Conflictos Históricos</div>
          <div id="kpiConflicts" class="text-2xl sm:text-3xl font-black text-destructive mt-1">19</div>
          <div class="text-[11px] text-muted-foreground mt-0.5">Márgenes protegidos intactos</div>
        </div>
      </div>

      <!-- Filters Bar -->
      <div class="flex flex-col sm:flex-row gap-3 items-center justify-between bg-card p-4 rounded-xl border border-border">
        <input
          type="text"
          id="adminSearchInput"
          placeholder="Buscar por ID o nombre del producto..."
          class="w-full sm:w-80 rounded-lg border border-input bg-background px-3.5 py-2 text-xs sm:text-sm text-foreground focus:ring-2 focus:ring-primary min-h-[40px]"
        />

        <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
          <button
            onclick="window.applyFilter('all')"
            class="filter-pill rounded-full border border-border bg-background px-3 py-1 text-xs font-semibold hover:border-primary cursor-pointer active"
            data-filter="all"
          >
            Todos
          </button>
          <button
            onclick="window.applyFilter('low_stock')"
            class="filter-pill rounded-full border border-destructive/40 bg-destructive/10 text-destructive px-3 py-1 text-xs font-bold hover:bg-destructive/20 cursor-pointer"
            data-filter="low_stock"
          >
            Stock Crítico (<span id="lowStockPillCount">0</span>)
          </button>
          <button
            onclick="window.applyFilter('conflicts')"
            class="filter-pill rounded-full border border-destructive/30 bg-destructive/5 text-destructive px-3 py-1 text-xs font-semibold hover:bg-destructive/10 cursor-pointer"
            data-filter="conflicts"
          >
            19 Conflictos
          </button>
          <button
            onclick="window.applyFilter('incomplete')"
            class="filter-pill rounded-full border border-amber-300 bg-amber-50 text-amber-800 px-3 py-1 text-xs font-semibold hover:bg-amber-100 cursor-pointer"
            data-filter="incomplete"
          >
            Incompletos
          </button>
          <button
            onclick="window.applyFilter('moizo')"
            class="filter-pill rounded-full border border-primary/30 bg-primary/5 text-primary px-3 py-1 text-xs font-semibold hover:bg-primary/10 cursor-pointer"
            data-filter="moizo"
          >
            Moizo (49)
          </button>
          <button
            onclick="window.applyFilter('published')"
            class="filter-pill rounded-full border border-emerald-300 bg-emerald-50 text-emerald-800 px-3 py-1 text-xs font-semibold hover:bg-emerald-100 cursor-pointer"
            data-filter="published"
          >
            Publicados
          </button>

          <div class="flex items-center gap-1.5 pl-2 border-l border-border">
            <label for="adminProviderSelect" class="text-xs font-semibold text-muted-foreground whitespace-nowrap">Proveedor:</label>
            <select
              id="adminProviderSelect"
              class="rounded-lg border border-input bg-background px-2.5 py-1 text-xs font-semibold text-foreground hover:border-primary cursor-pointer min-h-[32px]"
            >
              <option value="">Todos los Proveedores</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Tabular Interface (Modernized Table) -->
      <div class="rounded-xl border border-border bg-card overflow-hidden shadow-xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="border-b border-border bg-secondary/50 font-semibold text-muted-foreground uppercase tracking-wider">
              <tr>
                <th class="py-3 px-3 w-12 text-center">ID</th>
                <th class="py-3 px-3">Artículo / Categoría</th>
                <th class="py-3 px-3">Pres.</th>
                <th class="py-3 px-3">Proveedor</th>
                <th class="py-3 px-3 text-center">Inventario</th>
                <th class="py-3 px-3">Precios por Lista</th>
                <th class="py-3 px-3 text-center">Publicación</th>
                <th class="py-3 px-3 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody id="productsTableBody" class="divide-y divide-border">
              <tr>
                <td colspan="8" class="py-12 text-center text-muted-foreground">
                  Cargando catálogo administrativo...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Modal: Edit Prices -->
    <div id="priceModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="w-full max-w-md rounded-2xl border border-border bg-card p-6 shadow-xl space-y-4">
        <div class="flex items-center justify-between border-b border-border pb-2">
          <h3 class="font-bold text-foreground text-sm">Editar Condiciones de Precio</h3>
          <button onclick="document.getElementById('priceModal').classList.add('hidden')" class="text-muted-foreground text-lg cursor-pointer">&times;</button>
        </div>

        <div class="space-y-1">
          <div id="priceModalProdName" class="font-bold text-sm text-foreground"></div>
          <div class="text-xs text-muted-foreground">Ajuste de costo con IVA y margen de recargo en Decimal.</div>
        </div>

        <form id="priceEditForm" class="space-y-3">
          <input type="hidden" id="editProdId" />
          
          <div class="space-y-1">
            <label class="text-xs font-semibold text-foreground">Lista Comercial</label>
            <select id="editListId" class="w-full rounded border border-input bg-background p-2 text-xs">
              <option value="1">Empresas / Limpieza</option>
              <option value="2">Residenciales</option>
              <option value="3">Lavandería profesional</option>
              <option value="4">Lavandería domiciliaria</option>
              <option value="5">Automotriz</option>
            </select>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1">
              <label class="text-xs font-semibold text-foreground">Costo c/IVA ($)</label>
              <input type="number" step="0.01" id="editCost" required class="w-full rounded border border-input bg-background p-2 text-xs" />
            </div>
            <div class="space-y-1">
              <label class="text-xs font-semibold text-foreground">Recargo (%)</label>
              <input type="number" step="0.0001" id="editMarkup" required class="w-full rounded border border-input bg-background p-2 text-xs" />
            </div>
          </div>

          <div class="rounded-lg bg-secondary/50 p-3 text-xs flex justify-between items-center">
            <span class="text-muted-foreground">Precio Venta Resultante:</span>
            <span id="previewCalculatedPrice" class="font-bold text-primary text-sm">$0.00</span>
          </div>

          <button
            type="submit"
            class="w-full rounded-lg bg-primary py-2 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-colors min-h-[40px] cursor-pointer"
          >
            Guardar Condición de Precio
          </button>
        </form>
      </div>
    </div>

    <!-- Modal: New Product -->
    <div id="newProductModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="w-full max-w-md rounded-2xl border border-border bg-card p-6 shadow-xl space-y-4">
        <div class="flex items-center justify-between border-b border-border pb-2">
          <h3 class="font-bold text-foreground text-sm">Alta de Producto Maestro</h3>
          <button onclick="document.getElementById('newProductModal').classList.add('hidden')" class="text-muted-foreground text-lg cursor-pointer">&times;</button>
        </div>

        <form id="newProductForm" class="space-y-3">
          <div class="space-y-1">
            <label class="text-xs font-semibold text-foreground">Nombre Comercial</label>
            <input type="text" id="newProdName" required placeholder="Ej: Detergente Multiuso 2 Rodríguez" class="w-full rounded border border-input bg-background p-2 text-xs" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1">
              <label class="text-xs font-semibold text-foreground">Presentación</label>
              <input type="text" id="newProdPres" placeholder="Ej: 5 L, Bidón 10 L" class="w-full rounded border border-input bg-background p-2 text-xs" />
            </div>
            <div class="space-y-1">
              <label class="text-xs font-semibold text-foreground">Proveedor</label>
              <input type="text" id="newProdProv" placeholder="Ej: Moizo, Gabriel" class="w-full rounded border border-input bg-background p-2 text-xs" />
            </div>
          </div>

          <div class="space-y-1">
            <label class="text-xs font-semibold text-foreground">Categoría</label>
            <input type="text" id="newProdCat" value="Limpieza General" class="w-full rounded border border-input bg-background p-2 text-xs" />
          </div>

          <button
            type="submit"
            class="w-full rounded-lg bg-primary py-2 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-colors min-h-[40px] cursor-pointer"
          >
            Dar de Alta
          </button>
        </form>
      </div>
    </div>

    <!-- Modal: Presupuesto PDF -->
    <div id="quoteModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="w-full max-w-lg rounded-2xl border border-border bg-card p-6 shadow-xl space-y-4">
        <div class="flex items-center justify-between border-b border-border pb-2">
          <h3 class="font-bold text-foreground text-sm">Emitir Presupuesto Formal PDF</h3>
          <button onclick="document.getElementById('quoteModal').classList.add('hidden')" class="text-muted-foreground text-lg cursor-pointer">&times;</button>
        </div>

        <form id="quotePdfForm" class="space-y-3">
          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1">
              <label class="text-xs font-semibold text-foreground">Cliente / Razón Social</label>
              <input type="text" id="quoteClientName" required placeholder="Ej: Residencial El Prado" class="w-full rounded border border-input bg-background p-2 text-xs" />
            </div>
            <div class="space-y-1">
              <label class="text-xs font-semibold text-foreground">Teléfono / WhatsApp</label>
              <input type="text" id="quoteClientPhone" placeholder="099 123 456" class="w-full rounded border border-input bg-background p-2 text-xs" />
            </div>
          </div>

          <div class="space-y-1">
            <label class="text-xs font-semibold text-foreground">Lista Comercial Aplicada</label>
            <select id="quoteListId" class="w-full rounded border border-input bg-background p-2 text-xs">
              <option value="1">Empresas / Limpieza</option>
              <option value="2">Residenciales</option>
              <option value="3">Lavandería profesional</option>
              <option value="4">Lavandería domiciliaria</option>
              <option value="5">Automotriz</option>
            </select>
          </div>

          <div class="space-y-2 border-t border-border pt-2">
            <label class="text-xs font-semibold text-foreground">Línea de Cotización</label>
            <div class="grid grid-cols-3 gap-2">
              <input type="number" id="quoteProdId" placeholder="ID Producto (Ej: 1)" required class="rounded border border-input bg-background p-2 text-xs" />
              <input type="number" id="quoteQty" value="5" min="1" placeholder="Cantidad" required class="rounded border border-input bg-background p-2 text-xs" />
              <input type="number" id="quoteDiscount" value="0" min="0" max="100" placeholder="Desc %" class="rounded border border-input bg-background p-2 text-xs" />
            </div>
          </div>

          <div class="rounded-lg bg-amber-50 border border-amber-200 p-2.5 text-[11px] text-amber-800">
            El PDF excluye costos y recargos internos, mostrando precios finales con IVA y membrete corporativo.
          </div>

          <button
            type="submit"
            id="quoteSubmitBtn"
            class="w-full rounded-lg bg-emerald-600 py-2.5 text-xs font-semibold text-white shadow hover:bg-emerald-700 transition-colors min-h-[40px] cursor-pointer"
          >
            Descargar Presupuesto PDF
          </button>
        </form>
      </div>
    </div>

    <!-- Modal: Adjust Stock & Inventory Alerts -->
    <div id="stockModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="w-full max-w-sm rounded-2xl border border-border bg-card p-6 shadow-xl space-y-4">
        <div class="flex items-center justify-between border-b border-border pb-2">
          <h3 class="font-bold text-foreground text-sm">Control de Stock e Inventario</h3>
          <button onclick="document.getElementById('stockModal').classList.add('hidden')" class="text-muted-foreground text-lg cursor-pointer">&times;</button>
        </div>

        <div class="space-y-1">
          <div id="stockModalProdName" class="font-bold text-sm text-foreground"></div>
          <div class="text-xs text-muted-foreground">Actualice el inventario físico y umbral de alerta temprana.</div>
        </div>

        <form id="stockEditForm" class="space-y-3">
          <input type="hidden" id="stockProdId" />

          <div class="space-y-1">
            <label for="stockCurrent" class="text-xs font-semibold text-foreground">Stock Físico Actual (Unidades)</label>
            <input type="number" id="stockCurrent" min="0" required class="w-full rounded border border-input bg-background p-2 text-xs" />
          </div>

          <div class="space-y-1">
            <label for="stockMinAlert" class="text-xs font-semibold text-foreground">Alerta Stock Crítico (Mínimo)</label>
            <input type="number" id="stockMinAlert" min="0" required class="w-full rounded border border-input bg-background p-2 text-xs" />
            <p class="text-[11px] text-muted-foreground">Se marcará en amarillo/rojo al llegar a este umbral.</p>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <input type="checkbox" id="stockAllowBackorder" class="rounded border-input text-primary focus:ring-primary" />
            <label for="stockAllowBackorder" class="text-xs text-foreground cursor-pointer select-none">Permitir venta sin stock (Backorder)</label>
          </div>

          <button
            type="submit"
            id="stockSubmitBtn"
            class="w-full rounded-lg bg-primary py-2.5 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-colors min-h-[40px] cursor-pointer"
          >
            Guardar Inventario
          </button>
        </form>
      </div>
    </div>

    <!-- Modal: Import Stock CSV / Excel -->
    <div id="importStockModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="w-full max-w-md rounded-2xl border border-border bg-card p-6 shadow-xl space-y-4">
        <div class="flex items-center justify-between border-b border-border pb-2">
          <h3 class="font-bold text-foreground text-sm">Carga Masiva de Stock (Excel / CSV)</h3>
          <button onclick="document.getElementById('importStockModal').classList.add('hidden')" class="text-muted-foreground text-lg cursor-pointer">&times;</button>
        </div>

        <div class="space-y-1">
          <p class="text-xs text-muted-foreground">
            Subí la planilla con los valores de stock actualizados. Mariana puede usar el botón "Exportar Excel / CSV", editar los números y arrastrar el archivo acá.
          </p>
        </div>

        <div
          id="importDropZone"
          class="border-2 border-dashed border-input rounded-xl p-6 text-center hover:border-primary transition-colors cursor-pointer bg-muted/20"
        >
          <div class="text-3xl mb-2">📑</div>
          <div class="text-xs font-semibold text-foreground" id="importFileName">
            Hacé clic o arrastrá acá el archivo CSV
          </div>
          <p class="text-[11px] text-muted-foreground mt-1">Requiere columnas: ID y Stock Actual</p>
          <input type="file" id="importFileInput" accept=".csv,text/csv" class="hidden" />
        </div>

        <div id="importFeedback" class="hidden rounded-lg p-3 text-xs"></div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button
            type="button"
            onclick="document.getElementById('importStockModal').classList.add('hidden')"
            class="rounded-lg border border-input bg-background px-3 py-2 text-xs font-medium text-muted-foreground hover:bg-accent cursor-pointer"
          >
            Cerrar
          </button>
          <button
            type="button"
            id="importSubmitBtn"
            class="rounded-lg bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-colors cursor-pointer"
          >
            Procesar e Importar
          </button>
        </div>
      </div>
    </div>

    <!-- Modal: Product Attachments (Drag & Drop Photo & Technical PDF) -->
    <div id="attachmentModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="w-full max-w-lg rounded-2xl border border-border bg-card p-6 shadow-xl space-y-4">
        <div class="flex items-center justify-between border-b border-border pb-2">
          <h3 class="font-bold text-foreground text-sm">Archivos del Producto: Foto y Ficha PDF</h3>
          <button onclick="document.getElementById('attachmentModal').classList.add('hidden')" class="text-muted-foreground text-lg cursor-pointer">&times;</button>
        </div>

        <div>
          <div id="attachProdName" class="font-bold text-sm text-foreground"></div>
          <input type="hidden" id="attachProdId" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Photo Upload Box -->
          <div class="border border-border rounded-xl p-4 space-y-3 bg-muted/10 flex flex-col justify-between">
            <div>
              <div class="text-xs font-bold text-foreground flex items-center justify-between">
                <span>Foto del Artículo</span>
                <span class="text-[10px] text-muted-foreground font-normal">JPG, PNG, WEBP</span>
              </div>
              <div id="attachPhotoPreviewContainer" class="mt-2 h-28 rounded-lg border border-border bg-background flex items-center justify-center overflow-hidden">
                <img id="attachPhotoPreview" src="" alt="Vista previa" class="hidden h-full w-full object-contain" />
                <span id="attachPhotoPlaceholder" class="text-[11px] text-muted-foreground">Sin foto asignada</span>
              </div>
            </div>

            <div
              id="photoDropZone"
              class="border-2 border-dashed border-input rounded-lg p-3 text-center hover:border-primary transition-colors cursor-pointer text-xs"
            >
              <span class="font-semibold text-primary">Arrastrá foto acá</span>
              <p class="text-[10px] text-muted-foreground mt-0.5">o hacé clic para elegir</p>
              <input type="file" id="photoFileInput" accept="image/*" class="hidden" />
            </div>
          </div>

          <!-- PDF Sheet Upload Box -->
          <div class="border border-border rounded-xl p-4 space-y-3 bg-muted/10 flex flex-col justify-between">
            <div>
              <div class="text-xs font-bold text-foreground flex items-center justify-between">
                <span>Ficha Técnica (PDF)</span>
                <span class="text-[10px] text-muted-foreground font-normal">PDF</span>
              </div>
              <div id="attachPdfPreviewContainer" class="mt-2 h-28 rounded-lg border border-border bg-background flex flex-col items-center justify-center p-2 text-center">
                <span id="attachPdfPlaceholder" class="text-[11px] text-muted-foreground">Sin ficha técnica PDF</span>
                <a id="attachPdfLink" href="" target="_blank" rel="noopener noreferrer" class="hidden text-xs text-primary font-bold hover:underline flex items-center gap-1">
                  <span>📄 Abrir Ficha Actual</span>
                </a>
              </div>
            </div>

            <div
              id="pdfDropZone"
              class="border-2 border-dashed border-input rounded-lg p-3 text-center hover:border-primary transition-colors cursor-pointer text-xs"
            >
              <span class="font-semibold text-primary">Arrastrá PDF acá</span>
              <p class="text-[10px] text-muted-foreground mt-0.5">o hacé clic para elegir</p>
              <input type="file" id="pdfFileInput" accept="application/pdf" class="hidden" />
            </div>
          </div>
        </div>

        <div id="attachFeedback" class="hidden rounded-lg p-3 text-xs"></div>
      </div>
    </div>
  </div>

  <script is:inline>
    const API_URL = 'http://localhost:8000/api/v1';
    let adminToken = localStorage.getItem('admin_token') || '';
    let allProducts = [];
    let activeFilter = 'all';

    const adminLoginView = document.getElementById('adminLoginView');
    const adminDashboard = document.getElementById('adminDashboard');
    const adminUserBar = document.getElementById('adminUserBar');
    const adminLoginForm = document.getElementById('adminLoginForm');
    const adminLoginError = document.getElementById('adminLoginError');
    const adminLogoutBtn = document.getElementById('adminLogoutBtn');
    const productsTableBody = document.getElementById('productsTableBody');
    const adminSearchInput = document.getElementById('adminSearchInput');

    function checkAdminAuth() {
      if (adminToken) {
        adminLoginView?.classList.add('hidden');
        adminDashboard?.classList.remove('hidden');
        adminUserBar?.classList.remove('hidden');
        loadAdminProducts();
      } else {
        adminLoginView?.classList.remove('hidden');
        adminDashboard?.classList.add('hidden');
        adminUserBar?.classList.add('hidden');
      }
    }

    adminLoginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      adminLoginError?.classList.add('hidden');
      const email = document.getElementById('adminEmail')?.value;
      const password = document.getElementById('adminPassword')?.value;

      try {
        const res = await fetch(`${API_URL}/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.detail || 'Credenciales incorrectas');
        }

        const data = await res.json();
        if (data.role !== 'ADMIN') {
          throw new Error('Esta cuenta no posee privilegios de Administrador.');
        }

        adminToken = data.access_token;
        localStorage.setItem('admin_token', adminToken);
        checkAdminAuth();
      } catch (err) {
        if (adminLoginError) {
          adminLoginError.textContent = err.message;
          adminLoginError.classList.remove('hidden');
        }
      }
    });

    adminLogoutBtn?.addEventListener('click', () => {
      adminToken = '';
      localStorage.removeItem('admin_token');
      checkAdminAuth();
    });

    function updateKpis() {
      const totalCount = allProducts.length;
      const lowStockCount = allProducts.filter((p) => p.current_stock <= p.min_stock_alert).length;
      const incompleteCount = allProducts.filter((p) => p.is_pending_draft).length;
      const moizoCount = allProducts.filter((p) => (p.provider || '').toLowerCase().includes('moizo')).length;
      const conflictCount = allProducts.filter((p) => p.prices.some((pr) => pr.has_conflict)).length;

      const kpiTotal = document.getElementById('kpiTotalProducts');
      if (kpiTotal) kpiTotal.textContent = String(totalCount);

      const kpiStock = document.getElementById('kpiCriticalStock');
      if (kpiStock) kpiStock.textContent = String(lowStockCount);

      const kpiInc = document.getElementById('kpiIncomplete');
      if (kpiInc) kpiInc.textContent = String(incompleteCount);

      const kpiMoi = document.getElementById('kpiMoizo');
      if (kpiMoi) kpiMoi.textContent = String(moizoCount);

      const kpiConf = document.getElementById('kpiConflicts');
      if (kpiConf) kpiConf.textContent = String(conflictCount);

      const lowPill = document.getElementById('lowStockPillCount');
      if (lowPill) lowPill.textContent = String(lowStockCount);
    }

    async function loadProviders() {
      if (!adminToken) return;
      try {
        const res = await fetch(`${API_URL}/admin/providers`, {
          headers: { Authorization: `Bearer ${adminToken}` },
        });
        if (!res.ok) return;
        const providers = await res.json();
        const select = document.getElementById('adminProviderSelect');
        if (select) {
          const currentVal = select.value;
          select.innerHTML = '<option value="">Todos los Proveedores</option>' +
            providers.map((pr) => `<option value="${pr}">${pr}</option>`).join('');
          select.value = currentVal;
        }
      } catch (e) {}
    }

    document.getElementById('adminProviderSelect')?.addEventListener('change', () => {
      renderProductsTable();
    });

    async function loadAdminProducts() {
      if (!adminToken) return;

      try {
        const res = await fetch(`${API_URL}/admin/products?limit=350`, {
          headers: { Authorization: `Bearer ${adminToken}` },
        });

        if (!res.ok) throw new Error('Error al consultar catálogo.');
        allProducts = await res.json();
        updateKpis();
        loadProviders();
        renderProductsTable();
      } catch (err) {
        if (productsTableBody) {
          productsTableBody.innerHTML = `<tr><td colspan="8" class="py-8 text-center text-destructive">${err.message}</td></tr>`;
        }
      }
    }

    window.applyFilter = function(filter) {
      activeFilter = filter;
      document.querySelectorAll('.filter-pill').forEach((btn) => {
        if (btn.getAttribute('data-filter') === filter) {
          btn.classList.add('ring-2', 'ring-primary');
        } else {
          btn.classList.remove('ring-2', 'ring-primary');
        }
      });
      renderProductsTable();
    };

    function renderProductsTable() {
      if (!productsTableBody) return;
      const query = (adminSearchInput?.value || '').toLowerCase().trim();
      const selectedProvider = document.getElementById('adminProviderSelect')?.value || '';

      const filtered = allProducts.filter((p) => {
        const matchesQuery = !query || p.name.toLowerCase().includes(query) || String(p.id).includes(query);
        if (!matchesQuery) return false;

        if (selectedProvider && p.provider !== selectedProvider) {
          return false;
        }

        if (activeFilter === 'low_stock') {
          return p.current_stock <= p.min_stock_alert;
        }
        if (activeFilter === 'conflicts') {
          return p.prices.some((pr) => pr.has_conflict);
        }
        if (activeFilter === 'incomplete') {
          return p.is_pending_draft;
        }
        if (activeFilter === 'moizo') {
          return (p.provider || '').toLowerCase().includes('moizo');
        }
        if (activeFilter === 'published') {
          return p.is_published;
        }
        return true;
      });

      if (filtered.length === 0) {
        productsTableBody.innerHTML = '<tr><td colspan="8" class="py-8 text-center text-muted-foreground">No se encontraron artículos con ese criterio.</td></tr>';
        return;
      }

      productsTableBody.innerHTML = filtered.map((p) => {
        const hasConflict = p.prices.some((pr) => pr.has_conflict);
        const conflictDetail = p.prices.find((pr) => pr.has_conflict)?.conflict_detail || '';

        let stockBadge = '';
        if (p.current_stock <= 0) {
          stockBadge = `
            <button onclick="window.openStockModal(${p.id})" class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-destructive/15 text-destructive border border-destructive/30 hover:bg-destructive/25 transition-colors cursor-pointer" title="Haga clic para editar stock">
              <span class="w-1.5 h-1.5 rounded-full bg-destructive"></span>
              Agotado (0)
            </button>
          `;
        } else if (p.current_stock <= p.min_stock_alert) {
          stockBadge = `
            <button onclick="window.openStockModal(${p.id})" class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/15 text-amber-700 dark:text-amber-400 border border-amber-500/30 hover:bg-amber-500/25 transition-colors cursor-pointer" title="Haga clic para editar stock">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
              Bajo (${p.current_stock}/${p.min_stock_alert})
            </button>
          `;
        } else {
          stockBadge = `
            <button onclick="window.openStockModal(${p.id})" class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30 hover:bg-emerald-500/25 transition-colors cursor-pointer" title="Haga clic para editar stock">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              ${p.current_stock} disp.
            </button>
          `;
        }

        let mediaBadges = '';
        if (p.image_url) {
          mediaBadges += `<span class="inline-flex items-center text-[10px] bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 px-1.5 py-0.5 rounded font-semibold cursor-pointer" onclick="window.openAttachmentModal(${p.id})" title="Ver foto">📷 Foto</span>`;
        }
        if (p.tech_sheet_url) {
          mediaBadges += `<a href="${API_URL.replace('/api/v1', '')}${p.tech_sheet_url}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-[10px] bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-300 px-1.5 py-0.5 rounded font-semibold hover:underline" title="Abrir ficha técnica PDF">📄 Ficha PDF</a>`;
        }

        return `
          <tr class="hover:bg-muted/40 transition-colors">
            <td class="py-2.5 px-3 font-mono font-bold text-center text-muted-foreground">${p.id}</td>
            <td class="py-2.5 px-3">
              <div class="font-bold text-foreground text-xs leading-snug">${p.name}</div>
              <div class="text-[11px] text-muted-foreground flex flex-wrap items-center gap-1.5 mt-0.5">
                <span>${p.category}</span>
                ${mediaBadges}
                ${hasConflict ? `<span class="bg-destructive/10 text-destructive px-1.5 py-0.2 rounded font-semibold text-[10px]" title="${conflictDetail}">Conflicto Histórico</span>` : ''}
                ${p.is_pending_draft ? '<span class="bg-amber-100 text-amber-800 px-1.5 py-0.2 rounded font-semibold text-[10px]">Ficha Incompleta</span>' : ''}
              </div>
            </td>
            <td class="py-2.5 px-3 font-medium text-foreground whitespace-nowrap">${p.presentation || '<span class="text-amber-600">-</span>'}</td>
            <td class="py-2.5 px-3 text-muted-foreground whitespace-nowrap font-medium">${p.provider || '<span class="text-amber-600">-</span>'}</td>
            <td class="py-2.5 px-3 text-center whitespace-nowrap">
              ${stockBadge}
            </td>
            <td class="py-2.5 px-3">
              <div class="flex flex-wrap gap-1 max-w-xs">
                ${p.prices.map((pr) => `
                  <span class="inline-block border border-border bg-background px-1.5 py-0.5 rounded text-[10px] whitespace-nowrap font-mono">
                    ${pr.commercial_list_name.slice(0, 3)}: <strong>$${pr.price_iva_inc ? Number(pr.price_iva_inc).toFixed(2) : '-'}</strong>
                  </span>
                `).join('')}
              </div>
            </td>
            <td class="py-2.5 px-3 text-center">
              <button
                onclick="window.togglePublish(${p.id}, ${!p.is_published})"
                class="rounded-full px-2.5 py-0.5 text-[11px] font-semibold transition-colors cursor-pointer ${
                  p.is_published
                    ? 'bg-emerald-100 text-emerald-800 border border-emerald-300 hover:bg-emerald-200'
                    : 'bg-muted text-muted-foreground border border-border hover:bg-muted/80'
                }"
              >
                ${p.is_published ? 'Publicado' : 'Oculto'}
              </button>
            </td>
            <td class="py-2.5 px-3 text-right whitespace-nowrap">
              <div class="flex items-center justify-end gap-1.5">
                <button
                  onclick="window.openAttachmentModal(${p.id})"
                  class="inline-block rounded border border-input bg-background px-2 py-1 text-[11px] font-medium hover:bg-accent cursor-pointer"
                  title="Subir foto o ficha técnica PDF por Drag & Drop"
                >
                  Archivos
                </button>
                <button
                  onclick="window.openStockModal(${p.id})"
                  class="inline-block rounded border border-input bg-background px-2 py-1 text-[11px] font-medium hover:bg-accent cursor-pointer"
                  title="Ajustar inventario y alertas"
                >
                  Stock
                </button>
                <button
                  onclick="window.openPriceModal(${p.id})"
                  class="inline-block rounded border border-input bg-background px-2 py-1 text-[11px] font-medium hover:bg-accent cursor-pointer"
                >
                  Precios
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    adminSearchInput?.addEventListener('input', renderProductsTable);

    window.togglePublish = async function(id, newState) {
      try {
        const res = await fetch(`${API_URL}/admin/products/${id}/publish`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${adminToken}`,
          },
          body: JSON.stringify({ is_published: newState }),
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.detail || 'No se pudo cambiar el estado.');
        }

        const prod = allProducts.find((p) => p.id === id);
        if (prod) prod.is_published = newState;
        renderProductsTable();
      } catch (err) {
        alert(err.message);
      }
    };

    window.openPriceModal = function(id) {
      const prod = allProducts.find((p) => p.id === id);
      if (!prod) return;

      document.getElementById('editProdId').value = prod.id;
      document.getElementById('priceModalProdName').textContent = `#${prod.id} - ${prod.name}`;
      
      const firstPrice = prod.prices[0] || {};
      document.getElementById('editCost').value = firstPrice.cost_iva_inc || '';
      document.getElementById('editMarkup').value = firstPrice.markup_percentage || '';
      calcPreview();

      document.getElementById('priceModal').classList.remove('hidden');
    };

    function calcPreview() {
      const cost = parseFloat(document.getElementById('editCost').value) || 0;
      const markup = parseFloat(document.getElementById('editMarkup').value) || 0;
      const res = cost * (1 + markup / 100);
      document.getElementById('previewCalculatedPrice').textContent = `$${res.toFixed(2)}`;
    }

    document.getElementById('editCost')?.addEventListener('input', calcPreview);
    document.getElementById('editMarkup')?.addEventListener('input', calcPreview);

    document.getElementById('priceEditForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = parseInt(document.getElementById('editProdId').value, 10);
      const listId = parseInt(document.getElementById('editListId').value, 10);
      const cost = parseFloat(document.getElementById('editCost').value);
      const markup = parseFloat(document.getElementById('editMarkup').value);

      try {
        const res = await fetch(`${API_URL}/admin/products/${id}/prices`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${adminToken}`,
          },
          body: JSON.stringify({
            prices: [{ commercial_list_id: listId, cost_iva_inc: cost, markup_percentage: markup }],
          }),
        });

        if (!res.ok) throw new Error('Error al actualizar precios.');
        alert('Condición de precio actualizada con éxito.');
        document.getElementById('priceModal').classList.add('hidden');
        loadAdminProducts();
      } catch (err) {
        alert(err.message);
      }
    });

    // New Product
    document.getElementById('openNewProductBtn')?.addEventListener('click', () => {
      document.getElementById('newProductModal')?.classList.remove('hidden');
    });

    document.getElementById('newProductForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('newProdName')?.value;
      const presentation = document.getElementById('newProdPres')?.value;
      const provider = document.getElementById('newProdProv')?.value;
      const category = document.getElementById('newProdCat')?.value;

      try {
        const res = await fetch(`${API_URL}/admin/products`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${adminToken}`,
          },
          body: JSON.stringify({ name, presentation, provider, category }),
        });

        if (!res.ok) throw new Error('Error al crear producto.');
        alert('Producto creado con éxito.');
        document.getElementById('newProductModal')?.classList.add('hidden');
        loadAdminProducts();
      } catch (err) {
        alert(err.message);
      }
    });

    // Quote PDF
    document.getElementById('openQuoteModalBtn')?.addEventListener('click', () => {
      document.getElementById('quoteModal')?.classList.remove('hidden');
    });

    document.getElementById('quotePdfForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const clientName = document.getElementById('quoteClientName')?.value;
      const clientPhone = document.getElementById('quoteClientPhone')?.value;
      const listId = parseInt(document.getElementById('quoteListId')?.value, 10);
      const prodId = parseInt(document.getElementById('quoteProdId')?.value, 10);
      const qty = parseInt(document.getElementById('quoteQty')?.value, 10);
      const discount = parseFloat(document.getElementById('quoteDiscount')?.value) || 0;

      try {
        const submitBtn = document.getElementById('quoteSubmitBtn');
        submitBtn.textContent = 'Compilando PDF...';
        submitBtn.disabled = true;

        const res = await fetch(`${API_URL}/admin/quotes/pdf`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${adminToken}`,
          },
          body: JSON.stringify({
            commercial_list_id: listId,
            client_name: clientName,
            client_phone: clientPhone,
            items: [{ product_id: prodId, quantity: qty, discount_percentage: discount }],
          }),
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.detail || 'Error al emitir presupuesto.');
        }

        const blob = await res.blob();
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Presupuesto_${clientName.replace(/\s+/g, '_')}.pdf`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        document.getElementById('quoteModal')?.classList.add('hidden');
      } catch (err) {
        alert(err.message);
      } finally {
        const submitBtn = document.getElementById('quoteSubmitBtn');
        submitBtn.textContent = 'Descargar Presupuesto PDF';
        submitBtn.disabled = false;
      }
    });

    // Stock & Inventory Control Modal
    window.openStockModal = function(id) {
      const prod = allProducts.find((p) => p.id === id);
      if (!prod) return;

      document.getElementById('stockProdId').value = String(prod.id);
      document.getElementById('stockModalProdName').textContent = `#${prod.id} - ${prod.name}`;
      document.getElementById('stockCurrent').value = String(prod.current_stock ?? 0);
      document.getElementById('stockMinAlert').value = String(prod.min_stock_alert ?? 5);
      document.getElementById('stockAllowBackorder').checked = Boolean(prod.allow_backorder);

      document.getElementById('stockModal').classList.remove('hidden');
    };

    document.getElementById('stockEditForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = parseInt(document.getElementById('stockProdId').value, 10);
      const currentStock = parseInt(document.getElementById('stockCurrent').value, 10);
      const minAlert = parseInt(document.getElementById('stockMinAlert').value, 10);
      const allowBackorder = document.getElementById('stockAllowBackorder').checked;

      const submitBtn = document.getElementById('stockSubmitBtn');
      submitBtn.textContent = 'Guardando...';
      submitBtn.disabled = true;

      try {
        const res = await fetch(`${API_URL}/admin/products/${id}/stock`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${adminToken}`,
          },
          body: JSON.stringify({
            current_stock: currentStock,
            min_stock_alert: minAlert,
            allow_backorder: allowBackorder,
          }),
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.detail || 'Error al actualizar inventario.');
        }

        const updated = await res.json();
        const idx = allProducts.findIndex((p) => p.id === id);
        if (idx !== -1) {
          allProducts[idx].current_stock = updated.current_stock;
          allProducts[idx].min_stock_alert = updated.min_stock_alert;
          allProducts[idx].allow_backorder = updated.allow_backorder;
          allProducts[idx].is_low_stock = updated.is_low_stock;
          allProducts[idx].is_out_of_stock = updated.is_out_of_stock;
        }

        document.getElementById('stockModal').classList.add('hidden');
        updateKpis();
        renderProductsTable();
      } catch (err) {
        alert(err.message);
      } finally {
        submitBtn.textContent = 'Guardar Inventario';
        submitBtn.disabled = false;
      }
    });

    // --- Export Inventory CSV (Excel Compatible) ---
    document.getElementById('exportInventoryBtn')?.addEventListener('click', async () => {
      if (!adminToken) return;
      const btn = document.getElementById('exportInventoryBtn');
      const originalText = btn.innerHTML;
      btn.innerHTML = '<span>Generando CSV...</span>';
      try {
        const res = await fetch(`${API_URL}/admin/inventory/export`, {
          headers: { Authorization: `Bearer ${adminToken}` },
        });
        if (!res.ok) throw new Error('Error al generar archivo CSV de inventario.');
        const blob = await res.blob();
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        const dateStr = new Date().toISOString().slice(0, 10);
        a.download = `inventario_2rodriguez_${dateStr}.csv`;
        document.body.appendChild(a);
        a.click();
        a.remove();
      } catch (err) {
        alert(err.message);
      } finally {
        btn.innerHTML = originalText;
      }
    });

    // --- Import Inventory CSV (Drag & Drop) ---
    let selectedImportFile = null;
    const importStockModal = document.getElementById('importStockModal');
    const importDropZone = document.getElementById('importDropZone');
    const importFileInput = document.getElementById('importFileInput');
    const importFileName = document.getElementById('importFileName');
    const importFeedback = document.getElementById('importFeedback');
    const importSubmitBtn = document.getElementById('importSubmitBtn');

    document.getElementById('openImportStockBtn')?.addEventListener('click', () => {
      selectedImportFile = null;
      if (importFileName) importFileName.textContent = 'Hacé clic o arrastrá acá el archivo CSV';
      if (importFileInput) importFileInput.value = '';
      importFeedback?.classList.add('hidden');
      importStockModal?.classList.remove('hidden');
    });

    importDropZone?.addEventListener('click', () => importFileInput?.click());

    importFileInput?.addEventListener('change', (e) => {
      if (e.target.files?.length) {
        selectedImportFile = e.target.files[0];
        if (importFileName) importFileName.textContent = `Archivo seleccionado: ${selectedImportFile.name}`;
      }
    });

    importDropZone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      importDropZone.classList.add('border-primary', 'bg-primary/5');
    });

    importDropZone?.addEventListener('dragleave', () => {
      importDropZone.classList.remove('border-primary', 'bg-primary/5');
    });

    importDropZone?.addEventListener('drop', (e) => {
      e.preventDefault();
      importDropZone.classList.remove('border-primary', 'bg-primary/5');
      if (e.dataTransfer.files?.length) {
        selectedImportFile = e.dataTransfer.files[0];
        if (importFileName) importFileName.textContent = `Archivo arrastrado: ${selectedImportFile.name}`;
      }
    });

    importSubmitBtn?.addEventListener('click', async () => {
      if (!selectedImportFile) {
        alert('Por favor selecciona o arrastra un archivo CSV.');
        return;
      }
      importSubmitBtn.disabled = true;
      importSubmitBtn.textContent = 'Importando...';
      importFeedback?.classList.add('hidden');

      try {
        const formData = new FormData();
        formData.append('file', selectedImportFile);

        const res = await fetch(`${API_URL}/admin/inventory/import`, {
          method: 'POST',
          headers: { Authorization: `Bearer ${adminToken}` },
          body: formData,
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.detail || 'Error en la importación.');
        }

        const data = await res.json();
        if (importFeedback) {
          importFeedback.className = 'rounded-lg p-3 text-xs bg-emerald-50 text-emerald-800 border border-emerald-200';
          let msg = `¡Éxito! Se actualizaron ${data.updated_count} productos.`;
          if (data.errors?.length) {
            msg += ` (Advertencias: ${data.errors.slice(0, 3).join(', ')})`;
          }
          importFeedback.textContent = msg;
          importFeedback.classList.remove('hidden');
        }

        loadAdminProducts();
        setTimeout(() => {
          importStockModal?.classList.add('hidden');
        }, 1800);
      } catch (err) {
        if (importFeedback) {
          importFeedback.className = 'rounded-lg p-3 text-xs bg-destructive/10 text-destructive border border-destructive/20';
          importFeedback.textContent = err.message;
          importFeedback.classList.remove('hidden');
        }
      } finally {
        importSubmitBtn.disabled = false;
        importSubmitBtn.textContent = 'Procesar e Importar';
      }
    });

    // --- Product Attachments Modal (Drag & Drop Photo & PDF) ---
    const attachmentModal = document.getElementById('attachmentModal');
    const attachProdId = document.getElementById('attachProdId');
    const attachProdName = document.getElementById('attachProdName');
    const attachPhotoPreview = document.getElementById('attachPhotoPreview');
    const attachPhotoPlaceholder = document.getElementById('attachPhotoPlaceholder');
    const attachPdfLink = document.getElementById('attachPdfLink');
    const attachPdfPlaceholder = document.getElementById('attachPdfPlaceholder');
    const attachFeedback = document.getElementById('attachFeedback');

    const photoDropZone = document.getElementById('photoDropZone');
    const photoFileInput = document.getElementById('photoFileInput');
    const pdfDropZone = document.getElementById('pdfDropZone');
    const pdfFileInput = document.getElementById('pdfFileInput');

    window.openAttachmentModal = function(id) {
      const prod = allProducts.find((p) => p.id === id);
      if (!prod) return;

      if (attachProdId) attachProdId.value = String(prod.id);
      if (attachProdName) attachProdName.textContent = `#${prod.id} - ${prod.name}`;
      attachFeedback?.classList.add('hidden');

      const baseOrigin = 'http://localhost:8000';
      if (prod.image_url) {
        if (attachPhotoPreview) {
          attachPhotoPreview.src = `${baseOrigin}${prod.image_url}`;
          attachPhotoPreview.classList.remove('hidden');
        }
        attachPhotoPlaceholder?.classList.add('hidden');
      } else {
        if (attachPhotoPreview) {
          attachPhotoPreview.src = '';
          attachPhotoPreview.classList.add('hidden');
        }
        attachPhotoPlaceholder?.classList.remove('hidden');
      }

      if (prod.tech_sheet_url) {
        if (attachPdfLink) {
          attachPdfLink.href = `${baseOrigin}${prod.tech_sheet_url}`;
          attachPdfLink.classList.remove('hidden');
        }
        attachPdfPlaceholder?.classList.add('hidden');
      } else {
        if (attachPdfLink) {
          attachPdfLink.href = '';
          attachPdfLink.classList.add('hidden');
        }
        attachPdfPlaceholder?.classList.remove('hidden');
      }

      attachmentModal?.classList.remove('hidden');
    };

    async function uploadFileAttachment(file, attachmentType) {
      const prodId = attachProdId?.value;
      if (!file || !prodId) return;

      if (attachFeedback) {
        attachFeedback.className = 'rounded-lg p-2.5 text-xs bg-blue-50 text-blue-800 border border-blue-200';
        attachFeedback.textContent = `Subiendo ${attachmentType === 'image' ? 'foto' : 'ficha técnica PDF'}...`;
        attachFeedback.classList.remove('hidden');
      }

      try {
        const formData = new FormData();
        formData.append('file', file);
        formData.append('product_id', prodId);
        formData.append('attachment_type', attachmentType);

        const res = await fetch(`${API_URL}/admin/attachments`, {
          method: 'POST',
          headers: { Authorization: `Bearer ${adminToken}` },
          body: formData,
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.detail || 'Error al subir archivo.');
        }

        const data = await res.json();
        const baseOrigin = 'http://localhost:8000';
        const prod = allProducts.find((p) => p.id === parseInt(prodId, 10));

        if (attachmentType === 'image') {
          if (prod) prod.image_url = data.url;
          if (attachPhotoPreview) {
            attachPhotoPreview.src = `${baseOrigin}${data.url}`;
            attachPhotoPreview.classList.remove('hidden');
          }
          attachPhotoPlaceholder?.classList.add('hidden');
        } else {
          if (prod) prod.tech_sheet_url = data.url;
          if (attachPdfLink) {
            attachPdfLink.href = `${baseOrigin}${data.url}`;
            attachPdfLink.classList.remove('hidden');
          }
          attachPdfPlaceholder?.classList.add('hidden');
        }

        if (attachFeedback) {
          attachFeedback.className = 'rounded-lg p-2.5 text-xs bg-emerald-50 text-emerald-800 border border-emerald-200';
          attachFeedback.textContent = 'Archivo subido y vinculado con éxito.';
        }
        renderProductsTable();
      } catch (err) {
        if (attachFeedback) {
          attachFeedback.className = 'rounded-lg p-2.5 text-xs bg-destructive/10 text-destructive border border-destructive/20';
          attachFeedback.textContent = err.message;
        }
      }
    }

    photoDropZone?.addEventListener('click', () => photoFileInput?.click());
    photoFileInput?.addEventListener('change', (e) => {
      if (e.target.files?.length) uploadFileAttachment(e.target.files[0], 'image');
    });
    photoDropZone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      photoDropZone.classList.add('border-primary', 'bg-primary/5');
    });
    photoDropZone?.addEventListener('dragleave', () => photoDropZone.classList.remove('border-primary', 'bg-primary/5'));
    photoDropZone?.addEventListener('drop', (e) => {
      e.preventDefault();
      photoDropZone.classList.remove('border-primary', 'bg-primary/5');
      if (e.dataTransfer.files?.length) uploadFileAttachment(e.dataTransfer.files[0], 'image');
    });

    pdfDropZone?.addEventListener('click', () => pdfFileInput?.click());
    pdfFileInput?.addEventListener('change', (e) => {
      if (e.target.files?.length) uploadFileAttachment(e.target.files[0], 'tech_sheet');
    });
    pdfDropZone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      pdfDropZone.classList.add('border-primary', 'bg-primary/5');
    });
    pdfDropZone?.addEventListener('dragleave', () => pdfDropZone.classList.remove('border-primary', 'bg-primary/5'));
    pdfDropZone?.addEventListener('drop', (e) => {
      e.preventDefault();
      pdfDropZone.classList.remove('border-primary', 'bg-primary/5');
      if (e.dataTransfer.files?.length) uploadFileAttachment(e.dataTransfer.files[0], 'tech_sheet');
    });

    // Check auth on page load
    checkAdminAuth();
  </script>
</BaseLayout>
