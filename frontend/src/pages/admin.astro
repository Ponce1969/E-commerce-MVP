    if (financesYearSelect) financesYearSelect.value = String(currentDate.getFullYear());

    function getSelectedFinancesPeriod() {
      const year = parseInt(financesYearSelect?.value || String(currentDate.getFullYear()), 10);
      const month = parseInt(financesMonthSelect?.value || String(currentDate.getMonth() + 1), 10);
      return { year, month };
    }

    async function loadFinancesData() {
      if (!adminToken) return;
      await Promise.all([loadFinancesSummary(), loadExpensesList()]);
    }

    async function loadFinancesSummary() {
      const { year, month } = getSelectedFinancesPeriod();
      try {
        const res = await fetch(`${API_URL}/admin/finances/summary?year=${year}&month=${month}`, {
          headers: { Authorization: `Bearer ${adminToken}` },
        });
        if (!res.ok) throw new Error('Error al consultar métricas financieras.');
        const data = await res.json();

        const formatCurrency = (val) => `$${Number(val || 0).toLocaleString('es-UY', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

        document.getElementById('kpiGrossRevenue').textContent = formatCurrency(data.gross_revenue);
        document.getElementById('kpiOrdersCount').textContent = `${data.orders_count} pedido(s) en ${data.period_label}`;
        document.getElementById('kpiCogs').textContent = formatCurrency(data.cogs);
        document.getElementById('kpiTotalExpenses').textContent = formatCurrency(data.total_expenses);
        
        const netProfitEl = document.getElementById('kpiNetProfit');
        const netProfitVal = Number(data.net_profit || 0);
        netProfitEl.textContent = formatCurrency(netProfitVal);
        if (netProfitVal >= 0) {
          netProfitEl.className = 'text-2xl sm:text-3xl font-black text-emerald-700 dark:text-emerald-400 mt-1';
        } else {
          netProfitEl.className = 'text-2xl sm:text-3xl font-black text-destructive mt-1';
        }

        document.getElementById('kpiGrossMargin').textContent = `Margen bruto: ${formatCurrency(data.gross_margin)}`;
        document.getElementById('kpiMarginPctBadge').textContent = `${data.margin_percentage}% retorno`;

        renderSvgChart(data.monthly_trend || []);
      } catch (err) {
        console.error('Error cargando finanzas:', err);
      }
    }

    function renderSvgChart(trend) {
      const svg = document.getElementById('financialSvgChart');
      if (!svg) return;

      if (!trend || trend.length === 0) {
        svg.innerHTML = '<text x="340" y="110" text-anchor="middle" fill="#64748b" font-size="12">Sin datos de tendencia</text>';
        return;
      }

      // Calculate max value for Y-axis scale
      let maxVal = 100;
      trend.forEach((item) => {
        const rev = Number(item.gross_revenue || 0);
        const exp = Number(item.expenses || 0);
        const profit = Number(item.net_profit || 0);
        maxVal = Math.max(maxVal, rev, exp, profit);
      });
      // Round maxVal up to a nice number
      maxVal = Math.ceil(maxVal * 1.15);

      const chartWidth = 680;
      const chartHeight = 220;
      const padLeft = 60;
      const padRight = 20;
      const padTop = 20;
      const padBottom = 35;
      const plotWidth = chartWidth - padLeft - padRight;
      const plotHeight = chartHeight - padTop - padBottom;

      let html = '';

      // Grid lines & Y labels (4 lines)
      for (let i = 0; i <= 4; i++) {
        const yVal = (maxVal / 4) * i;
        const yPos = padTop + plotHeight - (plotHeight / 4) * i;
        html += `
          <line x1="${padLeft}" y1="${yPos}" x2="${chartWidth - padRight}" y2="${yPos}" stroke="currentColor" stroke-opacity="0.1" stroke-dasharray="3,3" />
          <text x="${padLeft - 8}" y="${yPos + 3}" text-anchor="end" fill="#94a3b8" font-size="9" font-family="monospace">$${yVal >= 1000 ? (yVal / 1000).toFixed(0) + 'k' : yVal.toFixed(0)}</text>
        `;
      }

      // Render Bar Groups
      const slotWidth = plotWidth / trend.length;
      const barWidth = 12;
      const barGap = 3;

      trend.forEach((item, idx) => {
        const xCenter = padLeft + idx * slotWidth + slotWidth / 2;
        const revVal = Math.max(0, Number(item.gross_revenue || 0));
        const expVal = Math.max(0, Number(item.expenses || 0));
        const netVal = Number(item.net_profit || 0);

        const revHeight = (revVal / maxVal) * plotHeight;
        const expHeight = (expVal / maxVal) * plotHeight;
        const netHeight = (Math.abs(netVal) / maxVal) * plotHeight;

        const revY = padTop + plotHeight - revHeight;
        const expY = padTop + plotHeight - expHeight;
        const netY = padTop + plotHeight - netHeight;

        // Group of 3 bars: Revenue (Blue), Expenses (Rose), Net (Emerald or Red)
        const xRev = xCenter - (barWidth * 1.5 + barGap);
        const xExp = xCenter - barWidth * 0.5;
        const xNet = xCenter + (barWidth * 0.5 + barGap);

        html += `
          <g class="chart-group">
            <!-- Facturación -->
            <rect x="${xRev}" y="${revY}" width="${barWidth}" height="${revHeight}" rx="2" fill="#2563eb" opacity="0.9">
              <title>${item.month_label} - Facturación: $${revVal.toFixed(2)}</title>
            </rect>
            <!-- Gastos -->
            <rect x="${xExp}" y="${expY}" width="${barWidth}" height="${expHeight}" rx="2" fill="#f43f5e" opacity="0.9">
              <title>${item.month_label} - Gastos: $${expVal.toFixed(2)}</title>
            </rect>
            <!-- Ganancia Neta -->
            <rect x="${xNet}" y="${netY}" width="${barWidth}" height="${netHeight}" rx="2" fill="${netVal >= 0 ? '#10b981' : '#ef4444'}" opacity="0.95">
              <title>${item.month_label} - Ganancia Neta: $${netVal.toFixed(2)}</title>
            </rect>
            <!-- Month Label -->
            <text x="${xCenter}" y="${chartHeight - 10}" text-anchor="middle" fill="#64748b" font-size="10" font-weight="600">${item.month_label}</text>
          </g>
        `;
      });

      svg.innerHTML = html;
    }

    async function loadExpensesList() {
      const { year, month } = getSelectedFinancesPeriod();
      try {
        const res = await fetch(`${API_URL}/admin/finances/expenses?year=${year}&month=${month}&limit=100`, {
          headers: { Authorization: `Bearer ${adminToken}` },
        });
        if (!res.ok) throw new Error('Error al cargar lista de gastos.');
        const expenses = await res.json();

        if (!expensesTableBody) return;

        if (expenses.length === 0) {
          expensesTableBody.innerHTML = '<tr><td colspan="5" class="py-8 text-center text-muted-foreground">No hay gastos asentados en este período. Usá "+ Registrar Gasto" para cargar egresos.</td></tr>';
          return;
        }

        expensesTableBody.innerHTML = expenses.map((exp) => `
          <tr class="hover:bg-muted/40 transition-colors">
            <td class="py-2.5 px-3 font-mono text-muted-foreground whitespace-nowrap">${exp.expense_date}</td>
            <td class="py-2.5 px-3">
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-muted text-foreground border border-border">
                ${exp.category}
              </span>
            </td>
            <td class="py-2.5 px-3 font-medium text-foreground">${exp.description}</td>
            <td class="py-2.5 px-3 text-right font-mono font-bold text-destructive whitespace-nowrap">
              -$${Number(exp.amount).toLocaleString('es-UY', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
            </td>
            <td class="py-2.5 px-3 text-right whitespace-nowrap">
              <button
                onclick="window.deleteExpense(${exp.id})"
                class="text-xs text-destructive hover:underline font-semibold cursor-pointer"
                title="Eliminar gasto"
              >
                Eliminar
              </button>
            </td>
          </tr>
        `).join('');
      } catch (err) {
        if (expensesTableBody) {
          expensesTableBody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-destructive">${err.message}</td></tr>`;
        }
      }
    }

    refreshFinancesBtn?.addEventListener('click', loadFinancesData);
    financesMonthSelect?.addEventListener('change', loadFinancesData);
    financesYearSelect?.addEventListener('change', loadFinancesData);

    // Modal: Register Expense
    openExpenseModalBtn?.addEventListener('click', () => {
      if (expenseError) expenseError.classList.add('hidden');
      const dateInput = document.getElementById('expenseDate');
      if (dateInput) dateInput.value = new Date().toISOString().slice(0, 10);
      document.getElementById('expenseDescription').value = '';
      document.getElementById('expenseAmount').value = '';
      expenseModal?.classList.remove('hidden');
    });

    expenseForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (expenseError) expenseError.classList.add('hidden');

      const category = document.getElementById('expenseCategory').value;
      const description = document.getElementById('expenseDescription').value;
      const expenseDate = document.getElementById('expenseDate').value;
      const amount = parseFloat(document.getElementById('expenseAmount').value);

      const submitBtn = document.getElementById('expenseSubmitBtn');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Guardando...';

      try {
        const res = await fetch(`${API_URL}/admin/finances/expenses`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${adminToken}`,
          },
          body: JSON.stringify({
            category,
            description,
            expense_date: expenseDate,
            amount,
          }),
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.detail || 'Error al registrar gasto.');
        }

        expenseModal?.classList.add('hidden');
        loadFinancesData();
      } catch (err) {
        if (expenseError) {
          expenseError.textContent = err.message;
          expenseError.classList.remove('hidden');
        }
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Guardar Gasto';
      }
    });

    window.deleteExpense = async function(id) {
      if (!confirm('¿Seguro que deseas eliminar este registro de gasto?')) return;

      try {
        const res = await fetch(`${API_URL}/admin/finances/expenses/${id}`, {
          method: 'DELETE',
          headers: { Authorization: `Bearer ${adminToken}` },
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.detail || 'Error al eliminar gasto.');
        }

        loadFinancesData();
      } catch (err) {
        alert(err.message);
      }
    };

    // Check auth on page load
    checkAdminAuth();
  </script>
</BaseLayout>
