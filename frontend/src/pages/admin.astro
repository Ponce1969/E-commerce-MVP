    async function uploadFileAttachment(file, attachmentType) {
      const prodId = attachProdId?.value;
      if (!file || !prodId) return;

      if (attachFeedback) {
        attachFeedback.className = 'rounded-lg p-2.5 text-xs bg-blue-50 text-blue-800 border border-blue-200';
        attachFeedback.textContent = `Subiendo ${attachmentType === 'image' ? 'foto' : 'ficha técnica PDF'}...`;
        attachFeedback.classList.remove('hidden');
      }

      try {
        const formData = new FormData();
        formData.append('file', file);
        formData.append('product_id', prodId);
        formData.append('attachment_type', attachmentType);

        const res = await fetch(`${API_URL}/admin/attachments`, {
          method: 'POST',
          headers: { Authorization: `Bearer ${adminToken}` },
          body: formData,
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.detail || 'Error al subir archivo.');
        }

        const data = await res.json();
        const baseOrigin = 'http://localhost:8000';
        const prod = allProducts.find((p) => p.id === parseInt(prodId, 10));

        if (attachmentType === 'image') {
          if (prod) prod.image_url = data.url;
          if (attachPhotoPreview) {
            attachPhotoPreview.src = `${baseOrigin}${data.url}`;
            attachPhotoPreview.classList.remove('hidden');
          }
          attachPhotoPlaceholder?.classList.add('hidden');
        } else {
          if (prod) prod.tech_sheet_url = data.url;
          if (attachPdfLink) {
            attachPdfLink.href = `${baseOrigin}${data.url}`;
            attachPdfLink.classList.remove('hidden');
          }
          attachPdfPlaceholder?.classList.add('hidden');
        }

        if (attachFeedback) {
          attachFeedback.className = 'rounded-lg p-2.5 text-xs bg-emerald-50 text-emerald-800 border border-emerald-200';
          attachFeedback.textContent = 'Archivo subido y vinculado con éxito.';
        }
        renderProductsTable();
      } catch (err) {
        if (attachFeedback) {
          attachFeedback.className = 'rounded-lg p-2.5 text-xs bg-destructive/10 text-destructive border border-destructive/20';
          attachFeedback.textContent = err.message;
        }
      }
    }

