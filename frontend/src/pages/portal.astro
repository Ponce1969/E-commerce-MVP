  </div>

  <script is:inline>
    const isLocalDev = window.location.hostname === 'localhost' && window.location.port === '4321';
    const API_URL = isLocalDev ? 'http://localhost:8000/api/v1' : '/api/v1';
    const baseOrigin = isLocalDev ? 'http://localhost:8000' : '';
    let customerToken = localStorage.getItem('customer_token') || '';
    let customerEmail = localStorage.getItem('customer_email') || '';
    let cart = []; // { product_id, name, price, quantity }

    const loginView = document.getElementById('loginView');
    const catalogView = document.getElementById('catalogView');
    const userBar = document.getElementById('userBar');
    const userEmailEl = document.getElementById('userEmail');
    const loginForm = document.getElementById('loginForm');
    const loginError = document.getElementById('loginError');
    const logoutBtn = document.getElementById('logoutBtn');
    const portalGrid = document.getElementById('portalGrid');
    const portalLoading = document.getElementById('portalLoading');
    const portalSearch = document.getElementById('portalSearch');
    const cartBtn = document.getElementById('cartBtn');
    const cartCount = document.getElementById('cartCount');
    const cartModal = document.getElementById('cartModal');
    const closeCartBtn = document.getElementById('closeCartBtn');
    const cartItemsList = document.getElementById('cartItemsList');
    const cartSubtotal = document.getElementById('cartSubtotal');
    const cartDeliveryCost = document.getElementById('cartDeliveryCost');
    const cartGrandTotal = document.getElementById('cartGrandTotal');
    const addressGroup = document.getElementById('addressGroup');
    const pickupGroup = document.getElementById('pickupGroup');
    const shippingRecipient = document.getElementById('shippingRecipient');
    const shippingDoc = document.getElementById('shippingDoc');
    const shippingStreet = document.getElementById('shippingStreet');
    const shippingStreetNumber = document.getElementById('shippingStreetNumber');
    const shippingApartment = document.getElementById('shippingApartment');
    const shippingCity = document.getElementById('shippingCity');
    const shippingPhone = document.getElementById('shippingPhone');
    const shippingState = document.getElementById('shippingState');
    const shippingPostalCode = document.getElementById('shippingPostalCode');
    const shippingNotes = document.getElementById('shippingNotes');
    const pickupRecipient = document.getElementById('pickupRecipient');
    const pickupPhone = document.getElementById('pickupPhone');
    const orderNotes = document.getElementById('orderNotes');
    const confirmOrderBtn = document.getElementById('confirmOrderBtn');
    const orderError = document.getElementById('orderError');

    // Success modal elements
    const orderSuccessModal = document.getElementById('orderSuccessModal');
    const successOrderIdBadge = document.getElementById('successOrderIdBadge');
    const successTotalAmount = document.getElementById('successTotalAmount');
    const successReferenceCode = document.getElementById('successReferenceCode');
    const successWhatsAppBtn = document.getElementById('successWhatsAppBtn');
    const closeSuccessModalBtn = document.getElementById('closeSuccessModalBtn');

    let allCatalog = [];

    function updateAuthState() {
      if (customerToken) {
        loginView?.classList.add('hidden');
        catalogView?.classList.remove('hidden');
        userBar?.classList.remove('hidden');
        if (userEmailEl) userEmailEl.textContent = customerEmail;
        loadCatalog();
      } else {
        loginView?.classList.remove('hidden');
        catalogView?.classList.add('hidden');
        userBar?.classList.add('hidden');
      }
    }

    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      loginError?.classList.add('hidden');
      const email = document.getElementById('loginEmail')?.value;
      const password = document.getElementById('loginPassword')?.value;

      try {
        const res = await fetch(`${API_URL}/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.detail || 'Credenciales incorrectas');
        }

        const data = await res.json();
        if (data.role !== 'CUSTOMER') {
          throw new Error('Esta cuenta pertenece a Administración. Ingrese por la sección Mariana (Admin).');
        }

        customerToken = data.access_token;
        customerEmail = data.email;
        localStorage.setItem('customer_token', customerToken);
        localStorage.setItem('customer_email', customerEmail);
        updateAuthState();
      } catch (err) {
        if (loginError) {
          loginError.textContent = err.message;
          loginError.classList.remove('hidden');
        }
      }
    });

    logoutBtn?.addEventListener('click', () => {
      customerToken = '';
      customerEmail = '';
      cart = [];
      localStorage.removeItem('customer_token');
      localStorage.removeItem('customer_email');
      updateCartUI();
      updateAuthState();
    });

    async function loadCatalog() {
      if (!customerToken) return;
      if (portalLoading) portalLoading.classList.remove('hidden');

      try {
        const res = await fetch(`${API_URL}/portal/catalog?limit=200`, {
          headers: { Authorization: `Bearer ${customerToken}` },
        });

        if (!res.ok) {
          throw new Error('Error al obtener catálogo arancelario.');
        }

        allCatalog = await res.json();
        renderPortalProducts(allCatalog);
      } catch (err) {
        if (portalGrid) {
          portalGrid.innerHTML = `<div class="col-span-full text-center text-sm text-destructive py-8">${err.message}</div>`;
        }
      } finally {
        if (portalLoading) portalLoading.classList.add('hidden');
      }
    }

    function renderPortalProducts(products) {
      if (!portalGrid) return;
      if (products.length === 0) {
        portalGrid.innerHTML = '<div class="col-span-full text-center text-sm text-muted-foreground py-8">No hay artículos publicados en tu lista comercial por el momento.</div>';
        return;
      }

      portalGrid.innerHTML = products.map((p) => {
        const hasImg = Boolean(p.image_url);
        const imgSrc = hasImg ? (p.image_url.startsWith('http') ? p.image_url : `${baseOrigin}${p.image_url}`) : '';
        const hasPdf = Boolean(p.tech_sheet_url);
        const pdfSrc = hasPdf ? (p.tech_sheet_url.startsWith('http') ? p.tech_sheet_url : `${baseOrigin}${p.tech_sheet_url}`) : '';

        return `
        <div class="rounded-xl border border-border bg-card p-5 flex flex-col justify-between hover:border-primary/50 transition-all shadow-xs group">
          <div class="space-y-3">
            <!-- Product Media Container -->
            <div class="relative w-full h-44 rounded-lg bg-muted/20 border border-border/60 flex items-center justify-center p-2 overflow-hidden">
              ${hasImg
                ? `<img src="${imgSrc}" alt="${p.name.replace(/"/g, '&quot;')}" class="max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-105" loading="lazy" onerror="this.style.display='none'; const fb = this.nextElementSibling; if(fb) fb.style.display='flex';" />
                   <div class="hidden flex-col items-center justify-center text-muted-foreground/40 text-xs gap-1">
                     <svg class="h-8 w-8 stroke-current" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                     <span class="text-[10px] uppercase font-semibold">2 Rodríguez</span>
                   </div>`
                : `<div class="flex flex-col items-center justify-center text-muted-foreground/40 text-xs gap-1">
                     <svg class="h-8 w-8 stroke-current" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                     <span class="text-[10px] uppercase tracking-wider font-semibold">2 Rodríguez</span>
                   </div>`
              }
              ${hasPdf ? `
                <a
                  href="${pdfSrc}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="absolute top-2 right-2 inline-flex items-center gap-1 text-[10px] font-semibold text-purple-700 dark:text-purple-300 bg-purple-50/95 dark:bg-purple-950/80 hover:bg-purple-100 dark:hover:bg-purple-900 border border-purple-200 dark:border-purple-800 px-2 py-0.5 rounded shadow-xs transition-colors"
                  title="Descargar Ficha Técnica PDF"
                  onclick="event.stopPropagation();"
                >
                  <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                  <span>Ficha PDF</span>
                </a>
              ` : ''}
            </div>

            <!-- Categories and Badges -->
            <div class="flex items-center justify-between text-xs gap-2">
              <span class="rounded-full border border-border px-2.5 py-0.5 font-medium text-muted-foreground truncate max-w-[170px]">${p.category}</span>
              ${p.presentation ? `<span class="bg-secondary px-2 py-0.5 rounded font-semibold text-foreground text-[11px] whitespace-nowrap">${p.presentation}</span>` : ''}
            </div>

            <h4 class="font-bold text-base text-foreground line-clamp-2 leading-snug">${p.name}</h4>
          </div>

          <div class="pt-4 mt-4 border-t border-border flex items-center justify-between gap-2">
            <div class="flex flex-col">
              <span class="text-[11px] text-muted-foreground uppercase font-medium">Precio Tu Lista (IVA inc)</span>
              <span class="text-xl font-black text-primary">$${Number(p.price_iva_inc).toFixed(2)}</span>
            </div>
            <button
              onclick="window.addToCart(${p.id}, '${p.name.replace(/'/g, "\\'")}', ${p.price_iva_inc})"
              class="rounded-lg bg-primary px-3.5 py-2 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-colors min-h-[38px] cursor-pointer flex items-center gap-1.5"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
              <span>Agregar</span>
            </button>
          </div>
        </div>
      `;
      }).join('');
    }

    portalSearch?.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      const filtered = allCatalog.filter((p) => p.name.toLowerCase().includes(q) || p.category.toLowerCase().includes(q));
      renderPortalProducts(filtered);
    });

    window.addToCart = function(id, name, price) {
      const existing = cart.find((item) => item.product_id === id);
      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push({ product_id: id, name, price: Number(price), quantity: 1 });
      }
      updateCartUI();
    };

    function updateCartUI() {
      const count = cart.reduce((sum, item) => sum + item.quantity, 0);
      if (cartCount) cartCount.textContent = count;

      if (!cartItemsList) return;
      if (cart.length === 0) {
        cartItemsList.innerHTML = '<div class="text-center text-xs text-muted-foreground py-6">Tu carrito está vacío.</div>';
      } else {
        cartItemsList.innerHTML = cart.map((it, idx) => `
          <div class="flex items-center justify-between p-2.5 rounded-lg border border-border bg-background text-xs">
            <div class="flex flex-col flex-1 truncate pr-2">
              <span class="font-semibold text-foreground truncate">${it.name}</span>
              <span class="text-muted-foreground">$${it.price.toFixed(2)} c/u</span>
            </div>
            <div class="flex items-center gap-2">
              <input
                type="number"
                min="1"
                value="${it.quantity}"
                onchange="window.updateCartQty(${idx}, this.value)"
                class="w-14 rounded border border-input px-2 py-1 text-center text-xs bg-background"
              />
              <span class="font-bold text-foreground w-16 text-right">$${(it.price * it.quantity).toFixed(2)}</span>
              <button onclick="window.removeCartItem(${idx})" class="text-destructive font-bold px-1">&times;</button>
            </div>
          </div>
        `).join('');
      }

      calculateCartTotals();
    }

    window.updateCartQty = function(idx, val) {
      const qty = parseInt(val, 10);
      if (qty > 0) {
        cart[idx].quantity = qty;
        updateCartUI();
      }
    };

    window.removeCartItem = function(idx) {
      cart.splice(idx, 1);
      updateCartUI();
    };

    function calculateCartTotals() {
      const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      const deliveryRadio = document.querySelector('input[name="deliveryType"]:checked');
      const deliveryCost = deliveryRadio?.value === 'CADETERIA_MARCO_POSTAL' ? 250 : 0;

      const paymentRadio = document.querySelector('input[name="paymentMethod"]:checked');
      const isMercadoPago = paymentRadio?.value === 'MERCADO_PAGO';
      const paymentFee = isMercadoPago ? Math.round((subtotal + deliveryCost) * 0.07 * 100) / 100 : 0;
      const grandTotal = subtotal + deliveryCost + paymentFee;

      if (cartSubtotal) cartSubtotal.textContent = `$${subtotal.toFixed(2)}`;
      if (cartDeliveryCost) cartDeliveryCost.textContent = `$${deliveryCost.toFixed(2)}`;

      const paymentFeeRow = document.getElementById('paymentFeeRow');
      const cartPaymentFee = document.getElementById('cartPaymentFee');
      if (paymentFeeRow && cartPaymentFee) {
        if (isMercadoPago && paymentFee > 0) {
          cartPaymentFee.textContent = `+$${paymentFee.toFixed(2)}`;
          paymentFeeRow.classList.remove('hidden');
        } else {
          paymentFeeRow.classList.add('hidden');
        }
      }

      if (cartGrandTotal) cartGrandTotal.textContent = `$${grandTotal.toFixed(2)}`;
    }

    document.querySelectorAll('input[name="deliveryType"]').forEach((r) => {
      r.addEventListener('change', (e) => {
        if (e.target.value === 'CADETERIA_MARCO_POSTAL') {
          addressGroup?.classList.remove('hidden');
          pickupGroup?.classList.add('hidden');
        } else {
          addressGroup?.classList.add('hidden');
          pickupGroup?.classList.remove('hidden');
        }
        calculateCartTotals();
      });
    });

    document.querySelectorAll('input[name="paymentMethod"]').forEach((r) => {
      r.addEventListener('change', () => {
        calculateCartTotals();
      });
    });

    cartBtn?.addEventListener('click', () => {
      cartModal?.classList.remove('hidden');
    });

    closeCartBtn?.addEventListener('click', () => {
      cartModal?.classList.add('hidden');
    });

    confirmOrderBtn?.addEventListener('click', async () => {
      if (cart.length === 0) {
        alert('El carrito está vacío.');
        return;
      }

      orderError?.classList.add('hidden');
      const deliveryType = document.querySelector('input[name="deliveryType"]:checked')?.value || 'PICKUP_PASO_MOLINO';
      const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked')?.value || 'BROU_TRANSFER';
      const isMarcoPostal = deliveryType === 'CADETERIA_MARCO_POSTAL';

      // Validación de campos requeridos para Marco Postal
      if (isMarcoPostal) {
        const recipient = shippingRecipient?.value.trim();
        const doc = shippingDoc?.value.trim();
        const street = shippingStreet?.value.trim();
        const number = shippingStreetNumber?.value.trim();
        const city = shippingCity?.value.trim();
        const phone = shippingPhone?.value.trim();

        if (!recipient || !doc || !street || !number || !city || !phone) {
          if (orderError) {
            orderError.textContent = 'Por favor completa todos los campos obligatorios (*) de envío para el despacho con Marco Postal.';
            orderError.classList.remove('hidden');
          }
          return;
        }
      }

      const shippingAddressPayload = isMarcoPostal ? {
        recipient_name: shippingRecipient?.value.trim(),
        document_number: shippingDoc?.value.trim(),
        street: shippingStreet?.value.trim(),
        street_number: shippingStreetNumber?.value.trim(),
        apartment: shippingApartment?.value.trim() || null,
        city: shippingCity?.value.trim() || 'Montevideo',
        state: shippingState?.value.trim() || 'Montevideo',
        postal_code: shippingPostalCode?.value.trim() || '11900',
        phone: shippingPhone?.value.trim(),
        notes: shippingNotes?.value.trim() || null,
      } : {
        recipient_name: pickupRecipient?.value.trim() || (customerEmail || 'Cliente Retiro 2R'),
        document_number: '00000000',
        street: 'Ángel Salvo',
        street_number: '56',
        apartment: 'Paso Molino',
        city: 'Montevideo',
        state: 'Montevideo',
        postal_code: '11900',
        phone: pickupPhone?.value.trim() || '095250673',
        notes: 'Retiro en punto Paso Molino',
      };

      const requestPayload = {
        payment_method: paymentMethod, // 'BROU_TRANSFER' o 'MERCADO_PAGO'
        delivery_type: deliveryType,   // 'PICKUP_PASO_MOLINO' o 'CADETERIA_MARCO_POSTAL'
        shipping_address: shippingAddressPayload,
        delivery_notes: orderNotes?.value.trim() || null,
        items: cart.map((c) => ({ product_id: Number(c.product_id), quantity: Number(c.quantity) })),
      };

      try {
        confirmOrderBtn.disabled = true;
        confirmOrderBtn.textContent = 'Procesando Pedido...';

        const headers = { 'Content-Type': 'application/json' };
        if (customerToken) {
          headers['Authorization'] = `Bearer ${customerToken}`;
        }

        const res = await fetch(`${API_URL}/checkout/create-order`, {
          method: 'POST',
          headers,
          body: JSON.stringify(requestPayload),
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.detail || 'Error al procesar la orden en el servidor.');
        }

        const orderData = await res.json();

        // Vaciar carrito tras éxito
        cart = [];
        updateCartUI();
        cartModal?.classList.add('hidden');

        if (paymentMethod === 'MERCADO_PAGO') {
          if (orderData.init_point) {
            confirmOrderBtn.textContent = '¡Orden creada! Redirigiendo a Mercado Pago...';
            window.location.href = orderData.init_point;
            return;
          } else {
            alert(`¡Pedido #${orderData.order_id} registrado con éxito!\n\nModalidad: Mercado Pago (Hasta 12 cuotas)\nTotal: $${orderData.total_amount}\n\nCoordinaremos el link de pago oficial a la brevedad.`);
          }
        } else {
          // Modal de éxito para Transferencia Bancaria BROU
          if (orderSuccessModal) {
            if (successOrderIdBadge) successOrderIdBadge.textContent = `#2R-${orderData.order_id}`;
            if (successTotalAmount) successTotalAmount.textContent = `$${Number(orderData.total_amount).toFixed(2)}`;
            const refCode = orderData.bank_transfer_info?.referencia || `2R-${orderData.order_id}`;
            if (successReferenceCode) successReferenceCode.textContent = refCode;

            if (successWhatsAppBtn) {
              const waText = encodeURIComponent(`Hola Mariana, acabo de confirmar el pedido 2R-${orderData.order_id} por $${orderData.total_amount} mediante Transferencia Bancaria BROU (Referencia: ${refCode}). Adjunto el comprobante.`);
              successWhatsAppBtn.href = `https://wa.me/59895250673?text=${waText}`;
            }

            orderSuccessModal.classList.remove('hidden');
          }
        }
      } catch (err) {
        if (orderError) {
          orderError.textContent = err.message;
          orderError.classList.remove('hidden');
        }
      } finally {
        confirmOrderBtn.disabled = false;
        confirmOrderBtn.textContent = 'Confirmar y Enviar Pedido';
      }
    });

    closeSuccessModalBtn?.addEventListener('click', () => {
      orderSuccessModal?.classList.add('hidden');
    });

    // Forgot Password & Reset Modal Handlers
    const openForgotModalBtn = document.getElementById('openForgotModalBtn');
    const forgotModal = document.getElementById('forgotModal');
    const closeForgotModalBtn = document.getElementById('closeForgotModalBtn');
    const forgotForm = document.getElementById('forgotForm');
    const forgotFeedback = document.getElementById('forgotFeedback');
    const forgotSubmitBtn = document.getElementById('forgotSubmitBtn');

    const resetModal = document.getElementById('resetModal');
    const closeResetModalBtn = document.getElementById('closeResetModalBtn');
    const resetForm = document.getElementById('resetForm');
    const resetFeedback = document.getElementById('resetFeedback');
    const resetSubmitBtn = document.getElementById('resetSubmitBtn');

    openForgotModalBtn?.addEventListener('click', () => {
      forgotFeedback?.classList.add('hidden');
      forgotModal?.classList.remove('hidden');
    });

    closeForgotModalBtn?.addEventListener('click', () => {
      forgotModal?.classList.add('hidden');
    });

    closeResetModalBtn?.addEventListener('click', () => {
      resetModal?.classList.add('hidden');
    });

    forgotForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('forgotEmail')?.value;
      if (!email) return;

      if (forgotSubmitBtn) {
        forgotSubmitBtn.disabled = true;
        forgotSubmitBtn.textContent = 'Enviando...';
      }

      try {
        const res = await fetch(`${API_URL}/auth/forgot-password`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        const data = await res.json().catch(() => ({}));
        if (forgotFeedback) {
          forgotFeedback.className = 'rounded-lg p-3 text-xs bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300';
          forgotFeedback.textContent = data.message || 'Si el correo está registrado, recibirás un enlace de recuperación.';
          forgotFeedback.classList.remove('hidden');
        }
      } catch (err) {
        if (forgotFeedback) {
          forgotFeedback.className = 'rounded-lg p-3 text-xs bg-destructive/10 border border-destructive/20 text-destructive';
          forgotFeedback.textContent = 'Ocurrió un error al procesar la solicitud.';
          forgotFeedback.classList.remove('hidden');
        }
      } finally {
        if (forgotSubmitBtn) {
          forgotSubmitBtn.disabled = false;
          forgotSubmitBtn.textContent = 'Enviar Enlace de Recuperación';
        }
      }
    });

    // Check if URL has reset_token
    const urlParams = new URLSearchParams(window.location.search);
    const resetToken = urlParams.get('reset_token');
    if (resetToken) {
      resetModal?.classList.remove('hidden');
    }

    resetForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const newPassword = document.getElementById('newPassword')?.value;
      if (!newPassword || !resetToken) return;

      if (resetSubmitBtn) {
        resetSubmitBtn.disabled = true;
        resetSubmitBtn.textContent = 'Actualizando...';
      }

      try {
        const res = await fetch(`${API_URL}/auth/reset-password`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: resetToken, new_password: newPassword }),
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.detail || 'Error al actualizar contraseña.');
        }

        const data = await res.json();
        if (resetFeedback) {
          resetFeedback.className = 'rounded-lg p-3 text-xs bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300';
          resetFeedback.textContent = data.message || 'Contraseña actualizada.';
          resetFeedback.classList.remove('hidden');
        }

        setTimeout(() => {
          resetModal?.classList.add('hidden');
          window.location.href = '/portal';
        }, 2000);
      } catch (err) {
        if (resetFeedback) {
          resetFeedback.className = 'rounded-lg p-3 text-xs bg-destructive/10 border border-destructive/20 text-destructive';
          resetFeedback.textContent = err.message;
          resetFeedback.classList.remove('hidden');
        }
      } finally {
        if (resetSubmitBtn) {
          resetSubmitBtn.disabled = false;
          resetSubmitBtn.textContent = 'Guardar Nueva Contraseña';
        }
      }
    });

    // Initialize
    updateAuthState();
  </script>
</BaseLayout>
