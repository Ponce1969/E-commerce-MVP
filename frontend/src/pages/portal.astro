---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Área de Clientes | 2 Rodríguez Distribuidora" currentNav="portal">
  <div class="space-y-6">
    <!-- Header -->
    <div class="border-b border-border pb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-foreground">
          Área Exclusiva de Clientes
        </h1>
        <p class="text-sm text-muted-foreground mt-1">
          Consultá los precios preferenciales de tu cuenta, fichas técnicas y confirmá tus pedidos con despacho prioritario.
        </p>
      </div>

      <!-- User Bar (when logged in) -->
      <div id="userBar" class="hidden flex-wrap items-center gap-3">
        <div class="flex items-center gap-2 rounded-lg border border-border bg-card px-3 py-1.5 text-xs">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          <span id="userEmail" class="font-medium text-foreground"></span>
        </div>
        <button
          id="cartBtn"
          class="relative inline-flex items-center justify-center rounded-lg bg-primary px-3.5 py-2 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-colors min-h-[40px] gap-2 cursor-pointer"
        >
          <span>Carrito</span>
          <span id="cartCount" class="rounded-full bg-white text-primary px-1.5 py-0.2 text-[11px] font-bold">0</span>
        </button>
        <button
          id="logoutBtn"
          class="inline-flex items-center justify-center rounded-lg border border-input bg-background px-3 py-2 text-xs font-medium text-muted-foreground hover:bg-accent hover:text-foreground transition-colors min-h-[40px] cursor-pointer"
        >
          Cerrar Sesión
        </button>
      </div>
    </div>

    <!-- Login & Welcome View (shown when unauthenticated) -->
    <div id="loginView" class="max-w-xl mx-auto my-8 space-y-6">
      <!-- Login Card -->
      <div class="p-6 sm:p-8 rounded-2xl border border-border bg-card shadow-sm space-y-6">
        <div class="text-center space-y-1.5">
          <div class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            Acceso Clientes Registrados
          </div>
          <h2 class="text-2xl font-bold text-foreground">Bienvenido al Portal de Pedidos</h2>
          <p class="text-xs sm:text-sm text-muted-foreground">
            Ingresá con tu correo y contraseña para acceder a tus tarifas comerciales.
          </p>
        </div>

        <form id="loginForm" class="space-y-4">
          <div class="space-y-1">
            <label for="loginEmail" class="text-xs font-semibold text-foreground">Correo Electrónico</label>
            <input
              type="email"
              id="loginEmail"
              required
              placeholder="cliente@empresa.com"
              class="w-full rounded-lg border border-input bg-background px-3.5 py-2.5 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary min-h-[44px]"
            />
          </div>

          <div class="space-y-1">
            <div class="flex items-center justify-between">
              <label for="loginPassword" class="text-xs font-semibold text-foreground">Contraseña</label>
              <button
                type="button"
                id="openForgotModalBtn"
                class="text-[11px] text-primary hover:underline font-medium cursor-pointer"
              >
                ¿Olvidaste tu contraseña?
              </button>
            </div>
            <input
              type="password"
              id="loginPassword"
              required
              placeholder="••••••••"
              class="w-full rounded-lg border border-input bg-background px-3.5 py-2.5 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary min-h-[44px]"
            />
          </div>

          <div id="loginError" class="hidden rounded-lg bg-destructive/10 border border-destructive/20 p-3 text-xs text-destructive"></div>

          <button
            type="submit"
            id="loginSubmitBtn"
            class="w-full inline-flex items-center justify-center rounded-lg bg-primary py-2.5 text-sm font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-colors min-h-[44px] cursor-pointer"
          >
            Ingresar a Mi Cuenta
          </button>
        </form>
      </div>

      <!-- Welcome & Benefits Onboarding Card -->
      <div class="rounded-2xl border border-primary/20 bg-gradient-to-br from-primary/5 via-card to-emerald-500/5 p-6 sm:p-7 shadow-xs space-y-4">
        <div class="flex items-start gap-3">
          <div class="h-10 w-10 shrink-0 rounded-xl bg-emerald-100 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 flex items-center justify-center font-bold text-lg">
            ✨
          </div>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-foreground">¿Querés ser cliente y acceder a beneficios exclusivos?</h3>
            <p class="text-xs sm:text-sm text-muted-foreground mt-0.5 leading-relaxed">
              Si sos empresa, comercio, lavandería, residencial o profesional independiente, te habilitamos tu cuenta comercial en minutos con condiciones preferenciales.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-1 text-xs">
          <div class="flex items-center gap-2 rounded-lg bg-background/80 border border-border p-2.5">
            <span class="text-emerald-600 font-bold">✓</span>
            <span class="font-medium text-foreground">Precios mayoristas por volumen</span>
          </div>
          <div class="flex items-center gap-2 rounded-lg bg-background/80 border border-border p-2.5">
            <span class="text-emerald-600 font-bold">✓</span>
            <span class="font-medium text-foreground">Retiro sin cargo en Paso Molino</span>
          </div>
          <div class="flex items-center gap-2 rounded-lg bg-background/80 border border-border p-2.5">
            <span class="text-emerald-600 font-bold">✓</span>
            <span class="font-medium text-foreground">Presupuestos formales con RUT</span>
          </div>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-border/80">
          <span class="text-xs text-muted-foreground text-center sm:text-left">
            Coordinación directa con Mariana para asignarte lista de precios.
          </span>
          <a
            href="https://wa.me/59895250673?text=Hola%20Mariana%2C%20quisiera%20solicitar%20el%20alta%20como%20cliente%20para%20acceder%20a%20precios%20mayoristas"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-lg bg-emerald-600 px-4 py-2.5 text-xs font-semibold text-white shadow-xs hover:bg-emerald-700 transition-colors gap-2 w-full sm:w-auto min-h-[40px]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Solicitar Alta por WhatsApp</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Portal Catalog View (shown when authenticated) -->
    <div id="catalogView" class="hidden space-y-6">
      <div class="flex flex-col sm:flex-row gap-4 items-center justify-between bg-card p-4 rounded-xl border border-border">
        <input
          type="text"
          id="portalSearch"
          placeholder="Filtrar productos autorizados..."
          class="w-full sm:w-1/2 rounded-lg border border-input bg-background px-3.5 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary min-h-[44px]"
        />
        <div class="text-xs text-muted-foreground font-medium">
          Lista Comercial Asignada: <strong id="portalListName" class="text-primary">Activa</strong>
        </div>
      </div>

      <div id="portalLoading" class="text-center py-12 text-sm text-muted-foreground">
        Cargando catálogo arancelario...
      </div>

      <div id="portalGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"></div>
    </div>

    <!-- Cart / Checkout Modal -->
    <div id="cartModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4">
      <div class="w-full max-w-lg rounded-2xl border border-border bg-card p-4 sm:p-6 shadow-xl flex flex-col max-h-[92vh]">
        <div class="flex items-center justify-between border-b border-border pb-3 shrink-0">
          <div class="flex items-center gap-2">
            <span class="text-xl">🛒</span>
            <div>
              <h3 class="text-base sm:text-lg font-bold text-foreground">Confirmar Pedido</h3>
              <p class="text-[11px] text-muted-foreground">Checkout mayorista directo con 2 Rodríguez</p>
            </div>
          </div>
          <button id="closeCartBtn" class="text-muted-foreground hover:text-foreground text-2xl p-1 cursor-pointer leading-none" aria-label="Cerrar">&times;</button>
        </div>

        <div class="flex-1 overflow-y-auto pr-1 space-y-4 py-3">
          <!-- Cart Items List -->
          <div>
            <div class="text-xs font-bold text-foreground uppercase tracking-wider mb-2">Artículos en tu orden:</div>
            <div id="cartItemsList" class="space-y-2.5"></div>
          </div>

          <!-- Logistics Selection -->
          <div class="space-y-3 border-t border-border pt-3">
            <div class="text-xs font-bold text-foreground uppercase tracking-wider">Modalidad de Entrega:</div>
            
            <label class="flex items-start gap-3 p-3 rounded-xl border border-border bg-background cursor-pointer hover:border-primary transition-colors">
              <input type="radio" name="deliveryType" value="PICKUP_PASO_MOLINO" checked class="mt-1" />
              <div class="text-xs space-y-0.5">
                <div class="font-bold text-foreground flex items-center gap-1.5">
                  <span>📍 Retiro en Paso Molino: Ángel Salvo 56</span>
                  <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 dark:bg-emerald-950/60 dark:text-emerald-300 px-1.5 py-0.2 rounded">Gratis $0</span>
                </div>
                <div class="text-muted-foreground text-[11px]">Ferretería al lado de la vía | Lun a Vie 08-12 / 14-18 | Sáb 08-13 hs</div>
              </div>
            </label>

            <label class="flex items-start gap-3 p-3 rounded-xl border border-border bg-background cursor-pointer hover:border-primary transition-colors">
              <input type="radio" name="deliveryType" value="CADETERIA_MARCO_POSTAL" class="mt-1" />
              <div class="text-xs space-y-0.5">
                <div class="font-bold text-foreground flex items-center gap-1.5">
                  <span>🚚 Cadetería Marco Postal</span>
                  <span class="text-[10px] font-bold text-blue-700 bg-blue-100 dark:bg-blue-950/60 dark:text-blue-300 px-1.5 py-0.2 rounded">+$250</span>
                </div>
                <div class="text-muted-foreground text-[11px]">Despacho formal con entrega en puerta en Montevideo.</div>
              </div>
            </label>

            <!-- Datos para Cadetería Marco Postal -->
            <div id="addressGroup" class="hidden space-y-3 p-3.5 rounded-xl border border-primary/20 bg-primary/5">
              <div class="text-xs font-bold text-foreground flex items-center gap-1.5">
                <span>📦</span> Datos de Despacho Marco Postal (Obligatorios)
              </div>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <div class="space-y-1">
                  <label for="shippingRecipient" class="text-[11px] font-semibold text-foreground">Nombre y Apellido Destinatario *</label>
                  <input type="text" id="shippingRecipient" placeholder="Nombre completo o Empresa" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-xs text-foreground min-h-[40px] focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
                <div class="space-y-1">
                  <label for="shippingDoc" class="text-[11px] font-semibold text-foreground">Documento (CI o RUT) *</label>
                  <input type="text" id="shippingDoc" placeholder="1.234.567-8 o 210000000000" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-xs text-foreground min-h-[40px] focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                <div class="sm:col-span-2 space-y-1">
                  <label for="shippingStreet" class="text-[11px] font-semibold text-foreground">Calle de Entrega *</label>
                  <input type="text" id="shippingStreet" placeholder="Ej: Av. Agraciada" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-xs text-foreground min-h-[40px] focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
                <div class="space-y-1">
                  <label for="shippingStreetNumber" class="text-[11px] font-semibold text-foreground">N° Puerta *</label>
                  <input type="text" id="shippingStreetNumber" placeholder="Ej: 3850" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-xs text-foreground min-h-[40px] focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                <div class="space-y-1">
                  <label for="shippingApartment" class="text-[11px] font-semibold text-foreground">Apto / Piso / Unidad</label>
                  <input type="text" id="shippingApartment" placeholder="Ej: Apto 204" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-xs text-foreground min-h-[40px] focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
                <div class="space-y-1">
                  <label for="shippingCity" class="text-[11px] font-semibold text-foreground">Barrio / Localidad *</label>
                  <input type="text" id="shippingCity" value="Paso Molino" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-xs text-foreground min-h-[40px] focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
                <div class="space-y-1">
                  <label for="shippingPhone" class="text-[11px] font-semibold text-foreground">Celular de Contacto *</label>
                  <input type="tel" id="shippingPhone" placeholder="095 250 673" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-xs text-foreground min-h-[40px] focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <div class="space-y-1">
                  <label for="shippingState" class="text-[11px] font-semibold text-foreground">Departamento *</label>
                  <input type="text" id="shippingState" value="Montevideo" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-xs text-foreground min-h-[40px] focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
                <div class="space-y-1">
                  <label for="shippingPostalCode" class="text-[11px] font-semibold text-foreground">Código Postal *</label>
                  <input type="text" id="shippingPostalCode" value="11900" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-xs text-foreground min-h-[40px] focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
              </div>

              <div class="space-y-1">
                <label for="shippingNotes" class="text-[11px] font-semibold text-foreground">Observaciones para el Fletero</label>
                <input type="text" id="shippingNotes" placeholder="Ej: Tocar timbre 204, entregar en recepción" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-xs text-foreground min-h-[40px] focus:outline-none focus:ring-2 focus:ring-primary" />
              </div>
            </div>

            <!-- Datos para Retiro en Paso Molino -->
            <div id="pickupGroup" class="space-y-2 p-3.5 rounded-xl border border-emerald-500/20 bg-emerald-50/20 dark:bg-emerald-950/10">
              <div class="text-xs font-bold text-emerald-800 dark:text-emerald-300 flex items-center gap-1.5">
                <span>📍</span> Retiro Inmediato en Ángel Salvo 56 (Paso Molino)
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <div class="space-y-1">
                  <label for="pickupRecipient" class="text-[11px] font-semibold text-foreground">Nombre de quien retira</label>
                  <input type="text" id="pickupRecipient" placeholder="Tu nombre o empresa" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-xs text-foreground min-h-[40px] focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
                <div class="space-y-1">
                  <label for="pickupPhone" class="text-[11px] font-semibold text-foreground">Celular WhatsApp de aviso</label>
                  <input type="tel" id="pickupPhone" placeholder="095 250 673" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-xs text-foreground min-h-[40px] focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
              </div>
            </div>

            <div class="space-y-1">
              <label for="orderNotes" class="text-[11px] font-semibold text-foreground">Notas Adicionales del Pedido</label>
              <input
                type="text"
                id="orderNotes"
                placeholder="Aclaraciones comerciales, factura con RUT, etc."
                class="w-full rounded-lg border border-input bg-background px-3 py-2 text-xs text-foreground min-h-[40px] focus:outline-none focus:ring-2 focus:ring-primary"
              />
            </div>
          </div>

          <!-- Payment Method Selection -->
          <div class="space-y-3 border-t border-border pt-3">
            <div class="flex items-center justify-between">
              <div class="text-xs font-bold text-foreground uppercase tracking-wider">Forma de Pago:</div>
              <span class="text-[10px] font-bold text-emerald-700 dark:text-emerald-300 bg-emerald-100 dark:bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-300 dark:border-emerald-800">
                Transferencia 100% Bonificada
              </span>
            </div>

            <!-- Opción Transferencia BROU / Redes -->
            <label class="flex items-start gap-3 p-3.5 rounded-xl border border-emerald-500/80 bg-emerald-50/20 dark:bg-emerald-950/10 cursor-pointer hover:border-emerald-600 transition-all">
              <input type="radio" name="paymentMethod" value="BROU_TRANSFER" checked class="mt-1" />
              <div class="text-xs space-y-1 flex-1">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-foreground text-sm flex items-center gap-1.5">
                    🏦 Transferencia BROU / Redes
                  </span>
                  <span class="text-[11px] font-bold text-emerald-700 dark:text-emerald-300 bg-emerald-100 dark:bg-emerald-900/40 px-2 py-0.5 rounded">
                    Sin arancel ($0)
                  </span>
                </div>
                <p class="text-muted-foreground text-[11px] leading-relaxed">
                  Precio de lista oficial sin recargo financiero. Acreditación directa a Mariana Moreira (BROU C/A: 110975226-00001 / Abitab - Redpagos: 601-0551790).
                </p>
              </div>
            </label>

            <!-- Opción Mercado Pago -->
            <label class="flex items-start gap-3 p-3.5 rounded-xl border border-border bg-background cursor-pointer hover:border-primary transition-all">
              <input type="radio" name="paymentMethod" value="MERCADO_PAGO" class="mt-1" />
              <div class="text-xs space-y-1 flex-1">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-foreground text-sm flex items-center gap-1.5">
                    💳 Mercado Pago Oficial
                  </span>
                  <span class="text-[11px] font-semibold text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/40 px-2 py-0.5 rounded border border-amber-200 dark:border-amber-800">
                    +7% arancel plataforma
                  </span>
                </div>
                <p class="text-muted-foreground text-[11px] leading-relaxed">
                  Aboná con tarjetas de crédito (hasta 12 cuotas), débito o saldo en cuenta a través de la pasarela segura.
                </p>
              </div>
            </label>
          </div>

          <!-- Total Breakdown -->
          <div class="border-t border-border pt-3 space-y-1.5 text-xs">
            <div class="flex justify-between text-muted-foreground">
              <span>Subtotal Ítems (IVA inc):</span>
              <span id="cartSubtotal" class="font-medium text-foreground">$0.00</span>
            </div>
            <div class="flex justify-between text-muted-foreground">
              <span>Costo de Entrega:</span>
              <span id="cartDeliveryCost" class="font-medium text-foreground">$0.00</span>
            </div>
            <div id="paymentFeeRow" class="hidden flex justify-between text-amber-700 dark:text-amber-400 font-medium">
              <span>Arancel financiero Mercado Pago (+7%):</span>
              <span id="cartPaymentFee">+$0.00</span>
            </div>
            <div class="flex justify-between text-base font-black text-primary pt-1.5 border-t border-border">
              <span>Total Final a Abonar:</span>
              <span id="cartGrandTotal">$0.00</span>
            </div>
          </div>

          <div id="orderError" class="hidden rounded-lg bg-destructive/10 border border-destructive/20 p-2.5 text-xs text-destructive"></div>
        </div>

        <div class="border-t border-border pt-3 shrink-0">
          <button
            id="confirmOrderBtn"
            class="w-full inline-flex items-center justify-center rounded-lg bg-primary py-3 text-sm font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-colors min-h-[44px] cursor-pointer gap-2"
          >
            <span>Confirmar y Enviar Pedido</span>
            <span>&rarr;</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Order Success Modal (BROU / Redes Instructions) -->
